    "i18n:report:models": "bun ./src/scripts/i18n/model-performance-report.ts",
    "i18n:translate:chunked": "bun ./src/scripts/i18n/translate-chunked.ts",
    "i18n:fix-mdx-indents": "bun ./src/scripts/i18n/fix-indented-mdx.ts",
    "news:watch": "bun ./src/scripts/news-watch/run-once.ts",
    "news:watch:daemon": "bun ./src/scripts/news-watch/daemon.ts",
    "news:watch:report": "bun ./src/scripts/news-watch/report.ts",
    "news:watch:extract": "bun ./src/scripts/news-watch/extract.ts",
    "news:watch:graph": "bun ./src/scripts/news-watch/graph.ts",
    "content:check": "bun ./src/scripts/check-content.ts",
    "content:fix": "bun ./src/scripts/fix-content.ts",
    "static": "PORT=4444 bunx serve dist",
    "screenshots": "bun ./screenshotter/index.ts",
    "video:capture:destination": "bun ./src/scripts/remotion/capture-destination-promo.ts",
    "video:render:destination": "bunx remotion render src/remotion/index.ts DestinationPromo public/remotion/destination-promo/danlevy-destination-promo.mp4 --gl=angle",
    "video:still:destination": "bunx remotion still src/remotion/index.ts DestinationPromo public/remotion/destination-promo/danlevy-destination-promo-frame.png --frame=120 --scale=0.5 --gl=angle",
    "video:studio": "bunx remotion studio src/remotion/index.ts",
    "dev": "astro check && astro dev",
    "start": "astro check && astro dev",
    "check": "astro check",
    "build": "unset GITHUB_TOKEN && NODE_OPTIONS=--max-old-space-size=8192 bun --env-file=.env astro build",
    "rebuild": "astro build --force",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rm -rf .astro .cache dist node_modules",
    "test:e2e": "playwright test -x",
    "test:e2e:ui": "playwright test --ui -x",
    "test:e2e:headed": "playwright test --headed -x",
    "test:e2e:debug": "playwright test --debug -x"
  },
