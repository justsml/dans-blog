 import { sql } from "./db";
 import { frame, sse } from "./logic";
+
+const setup = await sql.reserve();
+await setup`SELECT pg_advisory_lock(782342)`;
+try {
+  await setup`ALTER TABLE messages ADD COLUMN IF NOT EXISTS heartbeat timestamptz DEFAULT now()`;
+  await setup`CREATE TABLE IF NOT EXISTS stream_events (
+    message_id text NOT NULL REFERENCES messages(id), seq integer NOT NULL,
+    event text NOT NULL, data jsonb NOT NULL, PRIMARY KEY(message_id,seq))`;
+} finally {
+  await setup`SELECT pg_advisory_unlock(782342)`;
+  setup.release();
+}
+
+// A row lock serializes token writes, terminal transitions and cancellation.
+async function append(id: string, event: string, data: any, token = "") {
+  return sql.begin(async (tx) => {
+    const [row] =
+      await tx`SELECT status FROM messages WHERE id=${id} FOR UPDATE`;
+    if (row?.status !== "streaming") return false;
+    const [next] =
+      await tx`SELECT COALESCE(MAX(seq),0)+1 AS n FROM stream_events WHERE message_id=${id}`;
+    await tx`INSERT INTO stream_events VALUES (${id},${next.n},${event},${data}::jsonb)`;
+    const status =
+      event === "done" || event === "error" ? data.status : "streaming";
+    await tx`UPDATE messages SET content=content || ${token},status=${status},updated_at=now(),heartbeat=now() WHERE id=${id}`;
+    return true;
+  });
+}
+
+async function generate(id: string, content: string) {
+  const abort = new AbortController();
+  let checking = false;
+  const timer = setInterval(async () => {
+    if (checking) return;
+    checking = true;
+    try {
+      const rows =
+        await sql`UPDATE messages SET heartbeat=now() WHERE id=${id} AND status='streaming' RETURNING id`;
+      if (!rows.length) abort.abort();
+    } catch {
+      abort.abort();
+    } finally {
+      checking = false;
+    }
+  }, 200);
+  try {
+    await append(id, "message", { messageId: id });
+    const upstream = await fetch(`${process.env.LLM_URL}/v1/chat/completions`, {
+      method: "POST",
+      signal: abort.signal,
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        model: "team-chat",
+        stream: true,
+        messages: [{ role: "user", content }],
+      }),
+    });
+    if (!upstream.ok || !upstream.body)
+      throw new Error("Provider rejected request");
+    let completed = false;
+    for await (const data of sse(upstream.body)) {
+      if (data === "[DONE]") {
+        completed = true;
+        break;
+      }
+      const chunk = JSON.parse(data);
+      if (chunk.error) throw new Error("Provider interrupted");
+      const text = chunk.choices?.[0]?.delta?.content;
+      if (
+        typeof text === "string" &&
+        !(await append(id, "token", { text }, text))
+      ) {
+        abort.abort();
+        return;
+      }
+    }
+    if (!completed) throw new Error("Provider stream ended early");
+    await append(id, "done", { status: "complete" });
+  } catch {
+    await append(id, "error", {
+      status: "error",
+      message: "Generation interrupted",
+    });
+  } finally {
+    clearInterval(timer);
+    abort.abort();
+  }
+}
+
+// A rolling deployment may remove a producer without a graceful shutdown.
+let sweeping = false;
+const sweep = setInterval(async () => {
+  if (sweeping) return;
+  sweeping = true;
+  try {
+    const stale =
+      await sql`SELECT id FROM messages WHERE status='streaming' AND heartbeat < now()-interval '4 seconds'`;
+    for (const row of stale) {
+      await sql.begin(async (tx) => {
+        const [current] =
+          await tx`SELECT id FROM messages WHERE id=${row.id} AND status='streaming' AND heartbeat < now()-interval '4 seconds' FOR UPDATE`;
+        if (!current) return;
+        const [next] =
+          await tx`SELECT COALESCE(MAX(seq),0)+1 AS n FROM stream_events WHERE message_id=${row.id}`;
+        await tx`INSERT INTO stream_events VALUES (${row.id},${next.n},'error','{"status":"error","message":"Generation interrupted"}'::jsonb)`;
+        await tx`UPDATE messages SET status='error',updated_at=now() WHERE id=${row.id}`;
+      });
+    }
+  } catch (error) {
+    console.error("Stream recovery:", error);
+  } finally {
+    sweeping = false;
+  }
+}, 500);
+sweep.unref();
+
+export async function attach(req: Request, id: string) {
+  const raw =
+    new URL(req.url).searchParams.get("after") ??
+    req.headers.get("Last-Event-ID") ??
+    "0";
+  if (!/^\d+$/.test(raw) || !Number.isSafeInteger(Number(raw)))
+    return new Response("Invalid cursor", { status: 400 });
+  let cursor = Number(raw);
+  let closed = false;
+  let wake: (() => void) | undefined;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const stop = () => {
+    closed = true;
+    clearTimeout(timer);
+    wake?.();
+  };
+  req.signal.addEventListener("abort", stop, { once: true });
+  const stream = new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      // Fetch bounded pages only when this viewer is ready. Production has no
+      // dependency on the speed or lifetime of any individual response reader.
+      while (!closed) {
+        const rows =
+          await sql`SELECT seq,event,data FROM stream_events WHERE message_id=${id} AND seq>${cursor} ORDER BY seq LIMIT 64`;
+        for (const row of rows) {
+          if (closed) return;
+          controller.enqueue(
+            new TextEncoder().encode(frame(row.event, row.data, row.seq)),
+          );
+          cursor = row.seq;
+          if (row.event === "done" || row.event === "error") {
+            stop();
+            controller.close();
+            return;
+          }
+        }
+        if (rows.length) return;
+        const [row] = await sql`SELECT status FROM messages WHERE id=${id}`;
+        if (row?.status !== "streaming") {
+          const remaining =
+            await sql`SELECT seq FROM stream_events WHERE message_id=${id} AND seq>${cursor} LIMIT 1`;
+          if (remaining.length) continue;
+          stop();
+          controller.close();
+          return;
+        }
+        await new Promise<void>((resolve) => {
+          wake = resolve;
+          timer = setTimeout(resolve, 40);
+        });
+      }
+    },
+    cancel() {
+      stop();
+      req.signal.removeEventListener("abort", stop);
+    },
+  });
+  return new Response(stream, {
+    headers: {
+      "Content-Type": "text/event-stream",
+      "Cache-Control": "no-cache",
+      "X-Message-Id": id,
+    },
+  });
+}
