diff --git c/src/shipping.ts i/src/shipping.ts
new file mode 100644
index 0000000..47df835
--- /dev/null
+++ i/src/shipping.ts
@@ -0,0 +1,51 @@
+import rates from "../data/rates.json";
+import zones from "../data/zones.json";
+import type { Parcel } from "./packaging";
+
+export class ShippingError extends Error {}
+
+export interface Quote {
+  zone: number;
+  billableGrams: number;
+  amountCents: number;
+}
+
+const HALF_KG_GRAMS = 500;
+const MAX_ACTUAL_GRAMS = 30_000;
+const MAX_SIDE_CM = 150;
+/** cm³ per kg of dimensional weight (carrier rate card). */
+const DIM_DIVISOR = 5_000;
+
+/** Most specific prefix first, so Hawaii's "967" beats the regional "9". */
+const zoneChart = [...zones].sort((a, b) => b.prefix.length - a.prefix.length);
+
+export function zoneFor(zip: string): number {
+  const z = zip.trim();
+  if (!/^\d{5}(-\d{4})?$/.test(z)) throw new ShippingError(`invalid ZIP code ${zip}`);
+  const entry = zoneChart.find((e) => z.startsWith(e.prefix));
+  if (!entry) throw new ShippingError(`no shipping zone for ${zip}`);
+  return entry.zone;
+}
+
+/** Greater of actual and dimensional weight, rounded up to the next 0.5 kg. */
+export function billableGrams(p: Parcel): number {
+  const dimensionalGrams = (p.lengthCm * p.widthCm * p.heightCm * 1_000) / DIM_DIVISOR;
+  const grams = Math.max(p.weightGrams, dimensionalGrams);
+  return Math.max(1, Math.ceil(grams / HALF_KG_GRAMS)) * HALF_KG_GRAMS;
+}
+
+export function quoteShipping(parcel: Parcel, destinationZip: string): Quote {
+  if (parcel.weightGrams > MAX_ACTUAL_GRAMS) throw new ShippingError("parcel is over the carrier's 30 kg limit");
+  if (Math.max(parcel.lengthCm, parcel.widthCm, parcel.heightCm) > MAX_SIDE_CM) {
+    throw new ShippingError("parcel has a side over the carrier's 150 cm limit");
+  }
+  const zone = zoneFor(destinationZip);
+  const rate = (rates.zones as Record<string, { baseCents: number; perHalfKgCents: number }>)[String(zone)];
+  if (!rate) throw new ShippingError(`no rate for zone ${zone}`);
+
+  const billable = billableGrams(parcel);
+  const transportCents = rate.baseCents + rate.perHalfKgCents * (billable / HALF_KG_GRAMS - 1);
+  // ADR 0003: round the surcharge to the nearest cent, halves up.
+  const fuelCents = Math.round((transportCents * rates.fuelSurchargePercent) / 100);
+  return { zone, billableGrams: billable, amountCents: transportCents + fuelCents };
+}
