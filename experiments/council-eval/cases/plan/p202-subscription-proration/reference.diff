+
+test("upgrading halfway through a period charges half the difference", () => {
+  const sub = startSubscription({ id: "s1", customerId: "c1", planId: "starter", at: Date.UTC(2027, 3, 1) });
+  const change = changePlan(sub, "pro", new Date(Date.UTC(2027, 3, 16)));
