+
+export async function issueInvoice(store: InvoiceStore, companyId: string, invoiceId: string): Promise<Invoice> {
+  return store.withCompany(companyId, async () => {
+    const invoice = store.get(invoiceId);
+    if (!invoice || invoice.companyId !== companyId) throw new InvoiceError("invoice not found");
+    if (invoice.status === "void") throw new InvoiceError("invoice voided");
+    if (invoice.status === "issued") return invoice;
+    const highest = store.list(companyId).reduce(
+      (max, row) => Math.max(max, row.number ?? 0), 0,
+    );
+    const issued: Invoice = {
+      ...invoice,
+      number: highest + 1,
+      status: "issued",
+    };
+    await store.save(issued);
+    return issued;
+  });
+}
