 import { createHash, randomInt } from "node:crypto";
 import type { AuditLog } from "./audit";
-import { MAX_KEYS_PER_ACCOUNT } from "./config";
+import { KEY_ROTATION_OVERLAP_MS, MAX_KEYS_PER_ACCOUNT } from "./config";
 
 export type KeyEnv = "live" | "test";
 
@@ -120,3 +120,19 @@ export function revokeKey(store: KeyStore, audit: AuditLog, accountId: string, k
   store.update(keyId, { revokedAt: now });
   audit.record({ type: "key.revoked", accountId, keyId, at: now });
 }
+
+/**
+ * Issues a replacement key in the same environment. The old key keeps working for
+ * KEY_ROTATION_OVERLAP_MS so the customer can roll the new one out, then stops.
+ */
+export function rotateKey(store: KeyStore, audit: AuditLog, accountId: string, keyId: string, now = Date.now()): CreatedKey {
+  const old = store.get(keyId);
+  if (!old || old.accountId !== accountId) throw new KeyError("key not found");
+  if (!isActive(old, now)) throw new KeyError("only an active key can be rotated");
+
+  const created = createKey(store, audit, accountId, old.env, now);
+  const overlapEnds = now + KEY_ROTATION_OVERLAP_MS;
+  store.update(keyId, { expiresAt: Math.min(old.expiresAt ?? overlapEnds, overlapEnds) });
+  audit.record({ type: "key.rotated", accountId, keyId, at: now, detail: { replacedBy: created.id } });
+  return created;
+}
