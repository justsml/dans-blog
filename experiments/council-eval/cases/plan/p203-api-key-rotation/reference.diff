+
+test("after rotation both keys work until the old one runs out", () => {
+  const store = new KeyStore();
+  const audit = new AuditLog();
+  const old = createKey(store, audit, "acct_1", "live", 0);
+  const fresh = rotateKey(store, audit, "acct_1", old.id, 1_000);
+  expect(fresh.id).not.toBe(old.id);
+  expect(authenticate(store, fresh.secret, 1_001).keyId).toBe(fresh.id);
+  expect(authenticate(store, old.secret, 1_001).keyId).toBe(old.id);
