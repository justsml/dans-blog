@@ -14,18 +16,62 @@ export interface Schedule {
 
 export class ScheduleError extends Error {}
 
+export function isTimeZone(zone: string): boolean {
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone: zone });
+    return true;
+  } catch {
+    return false;
+  }
+}
+
 export function validateSchedule(s: Schedule) {
-  if (!Number.isInteger(s.hourUtc) || s.hourUtc < 0 || s.hourUtc > 23) {
+  if (!Number.isInteger(s.hour) || s.hour < 0 || s.hour > 23) {
     throw new ScheduleError("hour must be a whole number from 0 to 23");
   }
+  if (!isTimeZone(s.timeZone)) throw new ScheduleError(`unknown time zone ${s.timeZone}`);
   if (!/^[^@\s]+@[^@\s]+$/.test(s.ownerEmail)) throw new ScheduleError("owner email is invalid");
   if (!s.reportId) throw new ScheduleError("report is required");
 }
 
+const formatters = new Map<string, Intl.DateTimeFormat>();
+
+function formatter(timeZone: string): Intl.DateTimeFormat {
+  let f = formatters.get(timeZone);
+  if (!f) {
+    f = new Intl.DateTimeFormat("en-US", {
+      timeZone,
+      hourCycle: "h23",
+      year: "numeric",
+      month: "numeric",
+      day: "numeric",
+      hour: "numeric",
+      minute: "numeric",
+      second: "numeric",
+    });
+    formatters.set(timeZone, f);
+  }
+  return f;
+}
+
+/** Milliseconds to add to a UTC instant to get the wall-clock time in `timeZone`. */
+export function zoneOffset(timeZone: string, at: number): number {
+  const parts: Record<string, number> = {};
+  for (const p of formatter(timeZone).formatToParts(new Date(at))) parts[p.type] = Number(p.value);
+  const wall = Date.UTC(parts.year, parts.month - 1, parts.day, parts.hour, parts.minute, parts.second);
+  return wall - (at - (at % 1000));
+}
+
+/** Calendar date (YYYY-MM-DD) of an instant in the schedule's zone. */
+export function localDate(s: Schedule, at: number): string {
+  return new Date(at + zoneOffset(s.timeZone, at)).toISOString().slice(0, 10);
+}
+
 /** The first send time strictly after `after` (epoch ms). */
 export function nextRunAt(s: Schedule, after: number): number {
-  const d = new Date(after);
-  let run = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), s.hourUtc);
+  const offset = zoneOffset(s.timeZone, after);
+  const wall = new Date(after + offset);
+  let run = Date.UTC(wall.getUTCFullYear(), wall.getUTCMonth(), wall.getUTCDate(), s.hour) - offset;
   if (run <= after) run += DAY_MS;
   return run;
 }
