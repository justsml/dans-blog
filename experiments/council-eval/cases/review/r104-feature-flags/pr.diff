 }
+
+export function evaluate(flag: Flag | undefined, subject: string): boolean {
+  if (!flag || !flag.enabled) return false;
+  if (flag.percent === undefined) return true;
+  if (!subject) return false;
+  const assigned = bucket(subject, flag.salt ?? flag.key);
+  return assigned <= flag.percent * 100;
+}
+
+export function rolloutSummary(flag: Flag): string {
+  if (!flag.enabled) return "disabled";
+  if (flag.percent === undefined) return "everyone";
+  return flag.percent + "% of subjects";
+}
