diff --git a/test/contracts.test.ts b/test/contracts.test.ts
new file mode 100644
index 0000000..c8a51fe
--- /dev/null
+++ b/test/contracts.test.ts
@@ -0,0 +1,8 @@
+import {expect, test} from "bun:test";
+import {RateLimiter} from "../src/service";
+test("policy validation rejects invalid quotas and durations", () => {
+  const limiter = new RateLimiter();
+  expect(() => limiter.setPolicy("a", {requests: -1, windowMs: 100})).toThrow();
+  expect(() => limiter.setPolicy("a", {requests: 1, windowMs: 0})).toThrow();
+  expect(limiter.policyFor("a").requests).toBe(100);
+});
