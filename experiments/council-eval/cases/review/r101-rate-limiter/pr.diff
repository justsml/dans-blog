+import {expect,test} from "bun:test";
+import * as api from "../src/service";
+test("custom policy and reset",()=>{const l=new api.RateLimiter();l.setPolicy("a",{requests:2,windowMs:100});expect(l.check("a",0).remaining).toBe(1);expect(l.check("a",100).remaining).toBe(1);});
+test("policy removal restores defaults",()=>{const l=new api.RateLimiter();l.setPolicy("a",{requests:2,windowMs:100});l.clearPolicy("a");expect(l.policyFor("a").requests).toBe(100);});
