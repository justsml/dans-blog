diff --git a/src/refunds.ts b/src/refunds.ts
index 9449b72..ae78625 100644
--- a/src/refunds.ts
+++ b/src/refunds.ts
@@ -18,3 +18,22 @@ export function refundOrder(store: Store, userId: string, orderId: string, now =
   store.refunds.push({ orderId, amountCents, at: now });
   return { orderId, amountCents };
 }
+
+/** Refund part of an order, for example one item out of several. */
+export function refundPartial(store: Store, userId: string, orderId: string, amountCents: number, now = Date.now()) {
+  const order = store.getOrder(orderId);
+  if (!order) throw new RefundError("order not found");
+  if (order.status !== "paid" && order.status !== "partially_refunded") {
+    throw new RefundError(`cannot refund a ${order.status} order`);
+  }
+  if (!Number.isInteger(amountCents) || amountCents <= 0) {
+    throw new RefundError("amount must be a positive whole number of cents");
+  }
+  if (amountCents > order.totalCents) {
+    throw new RefundError("refund exceeds order total");
+  }
+  order.refundedCents += amountCents;
+  order.status = order.refundedCents === order.totalCents ? "refunded" : "partially_refunded";
+  store.refunds.push({ orderId, amountCents, at: now });
+  return { orderId, amountCents, remainingCents: order.totalCents - order.refundedCents };
+}
