+
+test("partial refund keeps the order open", () => {
+  const s = paid();
+  expect(refundPartial(s, "alice", "o1", 2_500)).toEqual({ orderId: "o1", amountCents: 2_500, remainingCents: 7_500 });
+  expect(s.getOrder("o1")?.status).toBe("partially_refunded");
+});
+
+test("partial refunds that add up to the total close the order", () => {
+  const s = paid();
+  refundPartial(s, "alice", "o1", 4_000);
+  refundPartial(s, "alice", "o1", 6_000);
+  expect(s.getOrder("o1")?.status).toBe("refunded");
+});
+
+test("partial refund rejects fractional cents", () => {
+  expect(() => refundPartial(paid(), "alice", "o1", 10.5)).toThrow(RefundError);
+});
