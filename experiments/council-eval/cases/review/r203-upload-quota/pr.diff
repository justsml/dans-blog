+  async storage(ownerId: string): Promise<StorageSummary> {
+    return { usedBytes: await this.usedBytes(ownerId), quotaBytes: this.quotaBytes };
+  }
+
+  /** Measured from the bucket itself, so the number matches what we are billed for. */
+  private async usedBytes(ownerId: string): Promise<number> {
+    let total = 0;
+    let next: string | undefined;
+    do {
+      const page = await this.blobs.list(`users/${ownerId}/`, next);
+      for (const key of page.keys) total += (await this.blobs.head(key))?.size ?? 0;
+      next = page.next;
+    } while (next);
+    return total;
+  }
