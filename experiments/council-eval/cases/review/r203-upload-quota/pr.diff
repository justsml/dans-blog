+
+test("uploads past the quota are rejected", async () => {
+  const svc = new FileService(new MemoryBlobStore(), new FileIndex(), { quotaBytes: 100 });
+  await svc.upload("u1", "a.bin", bytes(60), "application/octet-stream");
+  const err = await svc.upload("u1", "b.bin", bytes(50), "application/octet-stream").catch((e) => e);
+  expect(err).toBeInstanceOf(QuotaExceededError);
+  expect(err.usedBytes).toBe(60);
+  expect(svc.list("u1").map((f) => f.name)).toEqual(["a.bin"]);
+});
+
+test("quota is per user and freed by deletes", async () => {
+  const svc = new FileService(new MemoryBlobStore(), new FileIndex(), { quotaBytes: 100 });
+  await svc.upload("u1", "a.bin", bytes(80), "application/octet-stream");
+  await svc.upload("u2", "a.bin", bytes(80), "application/octet-stream");
+  await svc.remove("u1", "a.bin");
+  await svc.upload("u1", "b.bin", bytes(90), "application/octet-stream");
+  expect(await svc.storage("u1")).toEqual({ usedBytes: 90, quotaBytes: 100 });
+});
