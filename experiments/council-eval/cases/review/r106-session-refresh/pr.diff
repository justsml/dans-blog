diff --git a/src/service.ts b/src/service.ts
index cf1ace5..1b3f8a5 100644
--- a/src/service.ts
+++ b/src/service.ts
@@ -24,3 +24,25 @@ export function sessionView(store: SessionStore, token: string, now: number) {
     createdAt: session.createdAt,
   };
 }
+
+export interface RefreshResult {
+  userId: string;
+  expiresAt: number;
+}
+export function refresh(store: SessionStore, token: string, now: number, idleMs: number): RefreshResult {
+  if (!Number.isFinite(idleMs) || idleMs <= 0) {
+    throw new SessionError("idle duration must be positive");
+  }
+  const session = store.update(token, current => {
+    assertActive(current, now);
+    current.expiresAt = Math.min(
+      current.absoluteExpiresAt,
+      Math.max(current.expiresAt, now + idleMs),
+    );
+  });
+  assertActive(session, now);
+  return {
+    userId: session.userId,
+    expiresAt: session.expiresAt,
+  };
+}
