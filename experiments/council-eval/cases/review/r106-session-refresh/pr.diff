@@ -0,0 +1,10 @@
+import {expect, test} from "bun:test";
+import {refresh, SessionError} from "../src/service";
+import {SessionStore} from "../src/sessions";
+test("refresh rejects expired and unknown tokens", () => {
+  const store = new SessionStore();
+  store.create("t", "u", 0, 100, 1000);
+  expect(() => refresh(store, "t", 100, 100)).toThrow(SessionError);
+  expect(() => refresh(store, "missing", 50, 100)).toThrow(SessionError);
+  expect(store.get("t")?.expiresAt).toBe(100);
+});
