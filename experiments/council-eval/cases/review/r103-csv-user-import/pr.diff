-export function importUsers(users: Users, company: string, csv: string): ImportResult {
+export function importUsers(users: Users, company: string, csv: string, mode: "skip" | "update" = "skip"): ImportResult {
   const rows = parseCsv(csv);
+  let updated = 0;
   let created = 0;
   let skipped = 0;
   for (const row of rows) {
-    if (users.find(company, row.email)) {
+    const existing = mode === "update"
+      ? users.findByEmail(row.email)
+      : users.find(company, row.email);
+    if (existing && mode === "update") {
+      updateImportedUser(users, existing, row);
+      updated++;
+      continue;
+    }
+    if (existing) {
       skipped++;
       continue;
     }
     users.insert(company, row.email, row.name);
