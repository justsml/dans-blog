diff --git a/src/sweeper.ts b/src/sweeper.ts
new file mode 100644
index 0000000..7c23265
--- /dev/null
+++ b/src/sweeper.ts
@@ -0,0 +1,15 @@
+import type { ReservationService } from "./reservations";
+
+export interface SweeperOptions {
+  intervalMs?: number;
+  onExpired?: (count: number) => void;
+}
+
+/** Periodically returns abandoned holds to stock. Returns a function that stops it. */
+export function startSweeper(service: ReservationService, opts: SweeperOptions = {}): () => void {
+  const timer = setInterval(() => {
+    const expired = service.releaseExpired();
+    if (expired.length) opts.onExpired?.(expired.length);
+  }, opts.intervalMs ?? 60_000);
+  return () => clearInterval(timer);
+}
diff --git a/test/reservations.test.ts b/test/reservations.test.ts
index f6f4efb..46ec4f2 100644
--- a/test/reservations.test.ts
+++ b/test/reservations.test.ts
@@ -30,3 +30,36 @@ test("checkout sells the held units", () => {
   expect(inv.held("LAMP")).toBe(0);
   expect(() => completeCheckout(svc, "c1")).toThrow();
 });
+
+test("holds expire after the ttl and the stock comes back", () => {
+  let now = 1_000;
+  const inv = new Inventory();
+  inv.receive("LAMP", 5);
+  const svc = new ReservationService(inv, { clock: () => now, ttlMs: 60_000 });
+  const r = svc.reserve("c1", "LAMP", 4);
+  expect(r.expiresAt).toBe(61_000);
+
+  now = 30_000;
+  expect(svc.releaseExpired()).toEqual([]);
+  expect(inv.available("LAMP")).toBe(1);
+
+  now = 61_000;
+  expect(svc.releaseExpired().map((x) => x.id)).toEqual([r.id]);
+  expect(svc.get(r.id)?.status).toBe("expired");
+  expect(inv.available("LAMP")).toBe(5);
+});
+
+test("checkout drops lines whose hold ran out", () => {
+  let now = 0;
+  const inv = new Inventory();
+  inv.receive("LAMP", 5);
+  inv.receive("SHADE", 5);
+  const svc = new ReservationService(inv, { clock: () => now, ttlMs: 60_000 });
+  svc.reserve("c1", "LAMP", 1);
+  now = 50_000;
+  svc.reserve("c1", "SHADE", 2);
+  now = 70_000;
+  expect(completeCheckout(svc, "c1")).toEqual([{ sku: "SHADE", qty: 2 }]);
+  expect(inv.onHand("LAMP")).toBe(5);
+  expect(inv.onHand("SHADE")).toBe(3);
+});
