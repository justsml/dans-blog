--- /dev/null
+++ b/test/contracts.test.ts
@@ -0,0 +1,10 @@
+import {expect, test} from "bun:test";
+import {run} from "../src/service";
+import {Queue} from "../src/queue";
+test("type errors are terminal without another scheduled attempt", async () => {
+  const queue = new Queue();
+  queue.enqueue("j", "payload");
+  await run(queue, "j", async () => { throw new TypeError("invalid payload"); }, 0);
+  expect(queue.get("j")?.status).toBe("failed");
+  expect(queue.ready(100000)).toEqual([]);
+});
