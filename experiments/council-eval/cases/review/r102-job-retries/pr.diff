diff --git a/src/service.ts b/src/service.ts
index 7c93a35..5365964 100644
--- a/src/service.ts
+++ b/src/service.ts
@@ -4,15 +4,34 @@ export interface RunResult {
   ran: boolean;
   status?: string;
 }
+export interface RetryPolicy {
+  baseMs: number;
+  capMs: number;
+}
+export const retryPolicy: RetryPolicy = { baseMs: 1000, capMs: 60_000 };
+export function retryDelay(attempt: number, policy = retryPolicy): number {
+  if (attempt < 1) throw new Error("attempt must be positive");
+  return Math.min(policy.capMs, policy.baseMs * 2 ** (attempt - 1));
+}
+export function retryable(error: unknown): boolean {
+  return !(error instanceof TypeError);
+}
 export async function run(queue: Queue, id: string, handler: Handler, now = Date.now()): Promise<RunResult> {
-  const job = queue.claim(id, now);
+  const job = queue.get(id);
+  if (!job || job.status !== "queued" || job.availableAt > now) return { ran: false };
   if (!job) return { ran: false };
+  job.attempts++;
   try {
     await handler(job.payload);
     job.status = "done";
   } catch (error) {
     job.error = String(error);
-    job.status = "failed";
+    if (retryable(error)) {
+      job.availableAt = now + retryDelay(job.attempts);
+      job.status = "queued";
+    } else {
+      job.status = "failed";
+    }
   }
   return { ran: true, status: job.status };
 }
