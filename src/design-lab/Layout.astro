---
import { ClientRouter } from "astro:transitions";
import { designs, warmDesigns, isWarmDesign, type Design } from "./designs";
import Footer from "./Footer.astro";
import SurfacePicker from "./SurfacePicker.astro";
import ThemePicker from "./ThemePicker.astro";
import "./styles.css";
import "./surfaces.css";
import "./paper.css";
interface Props { design: Design; title?: string; article?: boolean }
const { design, title, article = false } = Astro.props;
const current = designs.find((item) => item.id === design)!;
const warm = isWarmDesign(design);
const options = warm ? warmDesigns : designs;
---
<!doctype html>
<html lang="en" data-design={design}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title ?? current.name} · DanLevy.net design lab</title>
    <meta name="description" content={current.note} />
    <link rel="icon" href="/favicon.ico" />
    <ClientRouter />
    <script is:inline data-astro-rerun>
      try {
        const preference = localStorage.getItem("design-lab-theme") || "system";
        document.documentElement.dataset.theme = preference === "system" ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : preference;
      } catch {
        document.documentElement.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
    </script>
    <script is:inline data-astro-rerun>
      (() => {
        if (document.documentElement.dataset.design === "warm-paper") {
          document.documentElement.dataset.surface = "none";
          return;
        }
        const allowed = ["none", "cotton", "mist", "mineral", "press", "light"];
        let surface = "cotton";
        const query = new URL(location.href).searchParams.get("surface");
        try {
          const saved = localStorage.getItem("design-lab-surface");
          if (saved && allowed.includes(saved)) surface = saved;
        } catch { /* Storage is optional. */ }
        if (query && allowed.includes(query)) {
          surface = query;
          try { localStorage.setItem("design-lab-surface", surface); } catch { /* URL selection still works. */ }
        }
        document.documentElement.dataset.surface = surface;
      })();
    </script>
  </head>
  <body class:list={[design, { "warm-editorial": warm && design !== "warm-editorial", "article-page": article }]} data-warm={warm ? true : undefined} data-pagefind-ignore="all">
    <a class="skip-link" href="#main">Skip to articles</a>
    <nav class="design-switcher" aria-label="Design previews">
      <span class="lab-label">Design lab</span>
      <div class="design-options">
        {options.map((item, index) => <a href={`/designs/${item.id}/`} aria-current={design === item.id ? "page" : undefined}><span>{index + 1}</span> {item.name}</a>)}
      </div>
      <a class="live-link" href="/">Current site ↗</a>
    </nav>
    {warm && design !== "warm-paper" && <SurfacePicker article={article} />}
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={`/designs/${design}/`}>DanLevy<span>.net</span></a>
        <nav aria-label="Main navigation">
          <a href={article ? `/designs/${design}/#articles` : "#articles"}>Articles</a>
          <a href="#explore">Explore</a>
          <a href="/about/">About</a>
        </nav>
        {!article && <label class="search-field"><span aria-hidden="true">⌕</span><input type="search" id="article-search" placeholder="Find a note…" aria-label="Search preview articles" /></label>}
        <ThemePicker />
      </header>
      <main id="main"><slot /></main>
      <Footer />
    </div>
    <script>import "./runtime";</script>
  </body>
</html>
