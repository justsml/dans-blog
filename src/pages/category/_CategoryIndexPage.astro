---
// import type { CollectionEntry } from "astro:content";
import Page from "@/layouts/Page.astro";
import { slugify } from "@/shared/pathHelpers";
import { PostCollections } from "../../shared/postsCache";
import socialBanner from "../../assets/social-banner.webp";
import { DEFAULT_LOCALE, getLocalizedPagePath, type Locale } from "../../shared/i18n";
import { getUiCopy } from "../../shared/uiTranslations";

const categories = PostCollections.getCategoryList();
const locale = (Astro.props.locale ?? DEFAULT_LOCALE) as Locale;
const copy = getUiCopy(locale);

const categoryList = Object.entries(categories).sort((a, b) => {
  return a[1] === b[1] ? 0 : a[1] < b[1] ? 1 : -1;
});
const catCount = categoryList.length;
const totalCount = categoryList.reduce((acc, [_, count]) => acc + count, 0);
---

<Page title={copy.category.title} subTitle={copy.category.description(catCount,totalCount)} socialImage={socialBanner} locale={locale} className="category-index-page">
  <section class="category-intro"><h1>{copy.category.heading}</h1><p>{copy.category.description(catCount,totalCount)}</p></section>
  <section class="category-list" aria-label={copy.category.heading}>
    {categoryList.map(([category,count]) => <a class="category-sheet" href={getLocalizedPagePath(`/category/${slugify(category)}/`,locale)}><h2>{category}</h2><span>{count}</span></a>)}
  </section>
</Page>
<style>
.category-intro { padding-block:1.5rem 2.5rem; }
.category-intro h1 { font-size:clamp(2.5rem,6vw,4.5rem); margin-block:0 .7rem; }
.category-intro p { color:var(--paper-muted); }
.category-list { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; padding:0; }
.category-sheet { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; background:var(--paper-sheet); padding:1.5rem; border:1px solid var(--paper-line); border-block-start:3px solid var(--paper-blue); color:var(--paper-ink); box-shadow:var(--paper-shadow); text-decoration:none; }
.category-sheet:nth-child(3n+2) { border-block-start-color:var(--paper-accent); }
.category-sheet h2 { font:500 1.45rem/1.3 var(--paper-serif); margin:0; }
.category-sheet span { font-size:.8rem; color:var(--paper-muted); }
.category-sheet:hover { color:var(--paper-accent); }
@media(max-width:800px) { .category-list { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media(max-width:500px) { .category-list { grid-template-columns:1fr; gap:1rem; } }
</style>
