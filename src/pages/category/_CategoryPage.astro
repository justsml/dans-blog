---
import { ArticleCard } from "../../components/ArticleCard";
import Page from "../../layouts/Page.astro";
import { PostCollections } from "../../shared/postsCache";
import type { ArticlePost } from "../../types";
import { DEFAULT_LOCALE, getLocalizedPagePath, type Locale } from "../../shared/i18n";
import { getUiCopy } from "../../shared/uiTranslations";
import { optimizeArticleCardImage } from "../../shared/articleImages";

type Props = {
  category: string;
  count: number;
  locale?: Locale;
};

const { category, count } = Astro.props as Props;
const locale = (Astro.props.locale ?? DEFAULT_LOCALE) as Locale;
const copy = getUiCopy(locale);
const posts = await Promise.all((PostCollections.getPostsByCategory(category, locale) as unknown as ArticlePost[]).map(post => optimizeArticleCardImage(post)));

// console.log("category.astro.props", Astro.props);
---

<style>

.path-display { display:flex; align-items:baseline; flex-wrap:wrap; gap:1rem; padding-block:1.5rem .5rem; }
.path-display h1 { font-size:clamp(2.5rem,6vw,4rem); margin:0; }
.path-display h3 { font-size:.8rem; font-weight:500; margin:0; }
.category-breadcrumb { color:var(--paper-muted); }
.category-count { color:var(--paper-muted); margin-block:0 2rem; }
.article-list { padding:0; }

</style>

<Page title={copy.category.pageTitle(category)} locale={locale}>
  <div class="path-display">
    <h3>
      <a class="category-breadcrumb" href={getLocalizedPagePath("/category/", locale)}>{copy.category.breadcrumb}</a>
    </h3>
    <h1>{category}</h1>
  </div>
  <p class="category-count">{copy.category.found(count)}</p>
  <div class:list={["article-list"]}>
    {
      posts.map((post) => <ArticleCard article={post} locale={locale} />)
    }
  </div>
</Page>
