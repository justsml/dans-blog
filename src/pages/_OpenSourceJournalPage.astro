---
import Page from "../layouts/Page.astro";
import RepoList from "../components/GitRepoCard/RepoList.astro";
import { DEFAULT_LOCALE, type Locale } from "../shared/i18n";
import { getUiCopy } from "../shared/uiTranslations";

const locale = (Astro.props.locale ?? DEFAULT_LOCALE) as Locale;
const copy = getUiCopy(locale);
---

<Page
  frontmatter={{
    title: copy.openSource.title,
    subTitle: copy.openSource.subTitle,
    // cover: "../../previews/open-source-journal/desktop-social.webp",
  }}
  locale={locale}
  socialImage={"/social/open-source-journal.png"}
  className="open-source-journal-page"
  pagefindBody
>
  <section class="oss-hero full-width">
    <div class="oss-hero-inner">
      <div class="oss-hero-main">
        <p class="oss-eyebrow">Open source journal</p>
        <h1>{copy.openSource.heading}</h1>
        <p class="oss-subtitle">{copy.openSource.subTitle}</p>
      </div>

      <blockquote class="oss-quote">
        {copy.openSource.quote}
      </blockquote>
    </div>
  </section>

  <RepoList className="h-resume" />
</Page>

<style>

:global(main.open-source-journal-page) { --oss-shell:min(1180px,calc(100vw - 3rem)); --oss-ink:var(--paper-ink); --oss-muted-copy:var(--paper-muted); --oss-rule:var(--paper-line); --oss-rust:var(--paper-accent); }
.oss-hero { padding:0; margin-block:1rem 2.5rem; }
.oss-hero-inner { max-width:1180px; margin-inline:auto; display:grid; grid-template-columns:1.4fr 1fr; gap:3rem; align-items:end; padding:2rem 1.5rem; }
.oss-eyebrow { color:var(--paper-accent); font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.14em; }
.oss-hero h1 { font:500 clamp(2.5rem,6vw,4.8rem)/1.05 var(--paper-serif); margin-block:.7rem 1.2rem; letter-spacing:-.04em; }
.oss-subtitle { color:var(--paper-muted); font-size:1.05rem; line-height:1.7; }
.oss-quote { padding:1.5rem; margin:0; background:var(--paper-sheet); box-shadow:var(--paper-shadow); border:1px solid var(--paper-line); border-block-start:3px solid var(--paper-accent); color:var(--paper-muted); font:italic 1.2rem/1.6 var(--paper-serif); }
@media(max-width:800px) { .oss-hero-inner { grid-template-columns:1fr; gap:1rem; padding:.75rem 1rem; } }
@media(max-width:600px) { .oss-hero { margin-block:.5rem 1.5rem; } .oss-hero h1 { font-size:2.25rem; } .oss-quote { padding:1rem; font-size:1rem; } }

</style>
