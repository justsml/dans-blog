---
import Layout from "../layouts/Page.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  INTRO_CALL_LINK,
  consultingServices,
} from "../data/consultingServices";
import type { ConsultingService } from "../data/consultingServices";
import consultingHeroImage from "../assets/consulting/consulting-hero-workbench-v2.webp";
import consultingProcessImage from "../assets/consulting/consulting-process-v2.webp";
import serviceAiConsultingImage from "../assets/consulting/service-ai-consulting-v2.webp";
import serviceAiGuardrailsImage from "../assets/consulting/service-ai-guardrails-v2.webp";
import serviceCodingSecurityImage from "../assets/consulting/service-coding-security-v2.webp";
import serviceEnterpriseSecurityImage from "../assets/consulting/service-enterprise-security-v2.webp";
import serviceRagImage from "../assets/consulting/service-rag-v2.webp";
import serviceSupabaseImage from "../assets/consulting/service-supabase-v2.webp";
import { DEFAULT_LOCALE, getLocalizedPagePath, type Locale } from "../shared/i18n";

const locale = (Astro.props.locale ?? DEFAULT_LOCALE) as Locale;
const pagePath = (path: string) => getLocalizedPagePath(path, locale);

const title = "Senior Software Architecture & Security Consulting";
const description =
  "Independent consulting for agentic coding, agentic applications, test-and-eval based development, security, RAG rescue, and modern architecture work.";

const featuredSlugs = ["ai-consulting", "ai-guardrails"];
const featuredServices = featuredSlugs
  .map((slug) => consultingServices.find((service) => service.slug === slug))
  .filter((service): service is ConsultingService => Boolean(service));
const supportingServices = consultingServices.filter(
  (service) => !featuredSlugs.includes(service.slug),
);

const heroImageSizes = "(max-width: 900px) calc(100vw - 3rem), 560px";
const featuredImageSizes = "(max-width: 900px) calc(100vw - 3rem), 520px";
const serviceImageSizes =
  "(max-width: 760px) calc(100vw - 3rem), (max-width: 1180px) 44vw, 340px";

const serviceVisuals: Record<string, { accent: string; mark: string; image: ImageMetadata }> = {
  "ai-consulting": {
    accent: "cyan",
    mark: "AI",
    image: serviceAiConsultingImage,
  },
  "ai-guardrails": {
    accent: "coral",
    mark: "GR",
    image: serviceAiGuardrailsImage,
  },
  "supabase-scaling-migration": {
    accent: "amber",
    mark: "SB",
    image: serviceSupabaseImage,
  },
  "rag-rescue": {
    accent: "cyan",
    mark: "RG",
    image: serviceRagImage,
  },
  "developer-ai-coding-security": {
    accent: "coral",
    mark: "CS",
    image: serviceCodingSecurityImage,
  },
  "enterprise-security-assessment": {
    accent: "amber",
    mark: "ES",
    image: serviceEnterpriseSecurityImage,
  },
};

const processSteps = [
  {
    title: "Define the target",
    body: "Turn architecture goals, failure cases, and product expectations into tests and evals.",
  },
  {
    title: "Fan out",
    body: "Use agentic coding to explore multiple implementation paths in parallel instead of betting on one.",
  },
  {
    title: "Converge",
    body: "Compare the outputs, combine the strongest pieces, and discard approaches that fail the checks.",
  },
  {
    title: "Ship with proof",
    body: "Land the change with eval coverage, observability, and handoff notes your team can keep using.",
  },
];

const serviceSummaries: Record<string, string> = {
  "ai-consulting":
    "Your AI costs are climbing and the answers are inconsistent. Build the routing, evals, and observability that fix both.",
  "ai-guardrails":
    "Your users are creative. Add policy controls, review paths, and eval gates before they find the fun edge cases.",
  "supabase-scaling-migration":
    "Your auth bill is bigger than your office rent. Let's fix that — with agents exploring the migration in parallel.",
  "rag-rescue":
    "RAG worked great at 500 docs. At 50,000 it's hallucinating confidently. Time to rebuild retrieval properly.",
  "developer-ai-coding-security":
    "AI coding tools are fast. That's the problem. Add sandboxes, access controls, and CI gates before they are.",
  "enterprise-security-assessment":
    "Security debt accumulates quietly until it doesn't. Find the compound risks before they find you.",
};

const trustSignals = [
  {
    value: "$22.5K/mo",
    label: "infrastructure cost removed before it compounded",
  },
  {
    value: "Eval-first",
    label: "pass/fail criteria defined before any agent runs",
  },
  {
    value: "Senior-only",
    label: "no handoffs — I write the code and own the outcome",
  },
  {
    value: "Fixed scope",
    label: "clear deliverables, no open-ended retainers",
  },
];

const proofPoints = [
  "Agentic delivery with evals — not just vibes and hope",
  "Parallel agent exploration instead of one slow serial plan",
  "Production AI design grounded in actual failure cases",
];

const caseProofs = consultingServices
  .filter((service) => service.caseStudy)
  .map((service) => ({
    service: service.navTitle,
    ...service.caseStudy!,
  }));

const fitSignals = [
  "Your AI app works great in the demo. In production it's... creative.",
  "You've been \"adding guardrails next sprint\" for four sprints now",
  "The migration estimate keeps growing and nobody wants to own it",
];
---

{/* The copy is English in every locale, so each copy canonicalises to /consulting/ with no hreflang twins. */}
<Layout frontmatter={{ title, subTitle: description }} locale={locale} canonicalPath="/consulting/" alternates={[]} pagefindBody>
  <section class="consulting-hero full-section">
    <div class="consulting-shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Independent senior consulting</p>
        <h1>Your AI app works great.<br />Mostly.</h1>
        <p class="hero-sub">
          I help teams go from "it works in the demo" to "it works in
          production" — with agentic coding, eval-driven development, and
          architecture that holds up when real users show up.
        </p>
        <div class="hero-actions">
          <a href={INTRO_CALL_LINK} class="btn btn-primary" target="_blank" rel="noopener">
            <span>Book diagnostic call</span>
            <span class="btn-icon" aria-hidden="true">↗</span>
          </a>
          <a href="#services" class="btn btn-secondary">See services</a>
        </div>
        <ul class="hero-proof" aria-label="Engagement proof">
          {proofPoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>

      <div class="hero-visual-stack">
        <div class="hero-art" aria-hidden="true">
          <Image
            src={consultingHeroImage}
            alt="AI consulting workbench with evaluation and architecture signals"
            widths={[480, 720, 960, 1280, 1586]}
            sizes={heroImageSizes}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="hero-insight-card">
          <div class="story-beat">
            <span>How it started</span>
            <strong>"GPT-3.5 sure can generate code!"</strong>
          </div>
          <div class="story-beat">
            <span>How it's going</span>
            <strong>Our swarm of Agents completed & tested 183 tickets before lunch. Six regressions were caught and fixed.</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-section full-section" aria-labelledby="trust-heading">
    <div class="consulting-shell trust-grid">
      <div>
        <p class="eyebrow">How I work</p>
        <h2 id="trust-heading">No surprises. Just results.</h2>
      </div>
      <div class="trust-copy">
        <p>
          Every engagement starts with a diagnostic — your logs, costs, incidents, and failure cases — so we both know exactly what we're fixing before any work begins. Deliverables are defined up front. You'll know what done looks like.
        </p>
      </div>
    </div>
    <div class="consulting-shell trust-metrics" aria-label="Consulting proof points">
      {trustSignals.map((signal) => (
        <article class="trust-metric">
          <strong>{signal.value}</strong>
          <span>{signal.label}</span>
        </article>
      ))}
    </div>
  </section>

  <section id="services" class="consulting-section full-section">
    <div class="consulting-shell">
      <div class="section-heading">
        <p class="eyebrow">Services</p>
        <h2>Pick your flavor of "we need help."</h2>
        <p>
          Whether your AI app is too expensive, too unpredictable, or just
          too scary to touch — there's a service for that.
        </p>
      </div>

      <div class="featured-services">
        {featuredServices.map((service) => {
          const visual = serviceVisuals[service.slug];
          return (
            <a class={`featured-card ${visual.accent}`} href={pagePath(`/consulting/${service.slug}/`)}>
              <div class="card-image" aria-hidden="true">
                <Image
                  src={visual.image}
                  alt={`${service.navTitle} consulting visual`}
                  widths={[320, 480, 720, 960]}
                  sizes={featuredImageSizes}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="service-mark">{visual.mark}</div>
              <p class="card-kicker">{service.kicker}</p>
              <h3>{service.navTitle}</h3>
              <p>{serviceSummaries[service.slug] ?? service.description}</p>
              <span class="card-link">Explore service <span aria-hidden="true">→</span></span>
            </a>
          );
        })}
      </div>

      <div class="service-grid">
        {supportingServices.map((service) => {
          const visual = serviceVisuals[service.slug] ?? {
            accent: "cyan",
            mark: service.navTitle.slice(0, 2).toUpperCase(),
            image: serviceAiConsultingImage,
          };
          return (
            <a class={`service-card ${visual.accent}`} href={pagePath(`/consulting/${service.slug}/`)}>
              <div class="supporting-image" aria-hidden="true">
                <Image
                  src={visual.image}
                  alt={`${service.navTitle} consulting visual`}
                  widths={[240, 360, 480, 720]}
                  sizes={serviceImageSizes}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="service-mark">{visual.mark}</div>
              <p class="card-kicker">{service.kicker}</p>
              <h3>{service.navTitle}</h3>
              <p>{serviceSummaries[service.slug] ?? service.description}</p>
              <span class="card-link">Explore service <span aria-hidden="true">→</span></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="consulting-section proof-section full-section">
    <div class="consulting-shell proof-grid">
      <div class="section-heading sticky-heading">
        <p class="eyebrow">Evidence</p>
        <h2>Results, not slides.</h2>
        <p>
          Migrations that used to take quarters. Auth bills that were eating
          the runway. RAG systems that worked great until they didn't. Real
          problems, fixed.
        </p>
      </div>
      <div class="case-stack">
        {caseProofs.map((item) => (
          <article class="case-card">
            <p class="card-kicker">{item.label} · {item.service}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <strong>{item.highlight}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="consulting-section process-section full-section">
    <div class="consulting-shell process-grid">
      <div>
        <p class="eyebrow">How I work</p>
        <h2>Not "throw agents at it."</h2>
        <p class="section-copy">
          Define what done looks like. Let agents explore in parallel.
          Use evals and senior judgment to pick the parts that actually work.
          Ship the thing. Repeat.
        </p>
        <a href={INTRO_CALL_LINK} class="btn btn-primary" target="_blank" rel="noopener">
          <span>Start diagnostic call</span>
          <span class="btn-icon" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="process-panel">
        <Image
          src={consultingProcessImage}
          alt="Consulting process board for eval-driven delivery"
          widths={[480, 720, 960, 1280]}
          sizes={heroImageSizes}
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
        <div class="steps">
          {processSteps.map((step, index) => (
            <article class="step">
              <span>0{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="signup" class="consulting-section signup-section full-section">
    <div class="consulting-shell signup-shell">
      <div class="signup-copy">
        <p class="eyebrow">Not ready to book?</p>
        <h2>Get notified when a diagnostic slot opens.</h2>
        <p class="section-copy">
          I take on a small number of engagements at a time. Leave your email
          and I'll reach out when there's room — plus the occasional note on
          what's actually working in production AI systems.
        </p>
      </div>

      <form
        name="consulting-signup"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        class="signup-form"
        id="consulting-signup-form"
      >
        <input type="hidden" name="form-name" value="consulting-signup" />
        <p class="signup-honeypot" aria-hidden="true">
          <label>
            Don't fill this out if you're human:
            <input name="bot-field" tabindex={-1} autocomplete="off" />
          </label>
        </p>
        <div class="signup-fields">
          <label class="signup-field">
            <span>Email address*</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@company.com"
            />
          </label>
          <label class="signup-field">
            <span>First name</span>
            <input
              type="text"
              name="first-name"
              autocomplete="given-name"
              placeholder="Jane"
            />
          </label>
        </div>
        <button type="submit" class="btn btn-primary signup-submit">
          <span>Notify me</span>
          <span class="btn-icon" aria-hidden="true">→</span>
        </button>
      </form>
      <p class="signup-status" id="consulting-signup-status" role="status" aria-live="polite"></p>
    </div>
  </section>

  <section id="about" class="consulting-section about-section full-section">
    <div class="consulting-shell about-grid">
      <div class="about-card">
        <div class="about-avatar">DL</div>
        <div>
          <p class="eyebrow">Dan Levy</p>
          <h2>Work directly with Dan Levy.</h2>
          <p>
            I work with a small number of companies each year. No account
            managers, no junior handoffs — just senior judgment near the
            implementation. Shaping agentic workflows, reviewing architecture,
            building evals, and helping ship changes your team can actually
            explain to each other.
          </p>
        </div>
      </div>

      <div class="capability-strip">
        <span>AI systems</span>
        <span>Guardrails</span>
        <span>RAG</span>
        <span>Supabase</span>
        <span>Security</span>
      </div>
    </div>
    <div class="consulting-shell fit-panel">
      <p class="eyebrow">Good fit</p>
      <div class="fit-list">
        {fitSignals.map((signal) => <p>{signal}</p>)}
      </div>
    </div>
  </section>

  <section class="consulting-cta full-section">
    <div class="consulting-shell cta-grid">
      <div>
        <p class="eyebrow">Next step</p>
        <h2>Bring the thing your team keeps not finishing.</h2>
        <p>
          The migration everyone's afraid to start. The agentic app that only
          works in staging. The AI product that's expensive and nobody's sure
          why. Let's figure out what's actually wrong and fix it.
        </p>
        <div class="hero-actions">
          <a href={INTRO_CALL_LINK} class="btn btn-primary" target="_blank" rel="noopener">
            <span>Book diagnostic call</span>
            <span class="btn-icon" aria-hidden="true">↗</span>
          </a>
          <a href={pagePath("/")} class="btn btn-secondary">Read the writing</a>
        </div>
      </div>
      <div class="cta-art" aria-hidden="true">
        <Image
          src={serviceEnterpriseSecurityImage}
          alt="Enterprise security consulting visual"
          widths={[480, 720, 960, 1280]}
          sizes={heroImageSizes}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>
</Layout>

<script>
  let signupListeners: AbortController | undefined;
  let signupForm: HTMLFormElement | null = null;
  function cleanupSignup() { signupListeners?.abort(); signupForm = null; }
  function initializeSignup() {
    const form = document.querySelector<HTMLFormElement>("#consulting-signup-form");
    if (form === signupForm) return;
    cleanupSignup();
    if (!form) return;
    signupForm = form;
    signupListeners = new AbortController();
    const { signal } = signupListeners;
    const status = document.getElementById("consulting-signup-status");
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    let submitting = false;
    form.addEventListener("submit", async event => {
      event.preventDefault();
      if (submitting || !form.reportValidity()) return;
      submitting = true;
      if (button) button.disabled = true;
      form.setAttribute("aria-busy", "true");
      if (status) status.textContent = "Sending…";
      const body = new URLSearchParams();
      new FormData(form).forEach((value, key) => { if (typeof value === "string") body.append(key, value); });
      try {
        const response = await fetch("/", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body, signal });
        if (!response.ok) throw new Error(`Form submission failed: ${response.status}`);
        if (signal.aborted || !form.isConnected) return;
        form.hidden = true;
        if (status) status.textContent = "Thanks — you're on the list. I'll be in touch when there's room.";
      } catch {
        if (!signal.aborted && status) status.textContent = "Something went wrong. Please try again or book a call directly.";
      } finally {
        submitting = false;
        if (!signal.aborted) {
          form.removeAttribute("aria-busy");
          if (button) button.disabled = false;
        }
      }
    }, { signal });
  }
  initializeSignup();
  document.addEventListener("astro:page-load", initializeSignup);
  document.addEventListener("astro:before-swap", cleanupSignup);
</script>

<style>

.full-section { grid-column:full-width; width:100%; padding:0; }
.consulting-shell { width:min(1180px,calc(100% - 3rem)); margin-inline:auto; min-width:0; }
.consulting-hero { padding-block:2rem 4rem; }
.hero-grid { display:grid; grid-template-columns:1.2fr 1fr; align-items:start; gap:3.5rem; }
.hero-copy h1 { font:500 clamp(2.8rem,5vw,4.8rem)/1.08 var(--paper-serif); letter-spacing:-.045em; margin-block:.9rem 1.5rem; color:var(--paper-ink); text-wrap:balance; }
.hero-sub,.section-copy,.trust-copy { color:var(--paper-muted); font-size:1.1rem; line-height:1.75; }
.eyebrow,.card-kicker { color:var(--paper-accent); font-size:.7rem; text-transform:uppercase; letter-spacing:.13em; font-weight:700; }
.hero-actions { display:flex; flex-wrap:wrap; gap:.75rem; margin-block:1.5rem; }
.btn { display:inline-flex; align-items:center; justify-content:center; gap:.75rem; padding:.9rem 1.2rem; min-height:44px; border:1px solid var(--paper-line); color:var(--paper-ink); text-decoration:none; font-size:.85rem; font-weight:600; transition:transform 180ms; }
.btn-primary { background:var(--paper-blue); color:var(--paper-on-blue); border-color:var(--paper-blue); }
.btn-secondary { background:var(--paper-sheet); }
.btn:hover { transform:translateY(-2px); }
.btn-icon { color:inherit; }
.hero-proof { display:flex; flex-wrap:wrap; gap:.5rem 1.2rem; padding:0; margin-block:2rem 0; color:var(--paper-muted); font-size:.75rem; list-style:none; }
.hero-proof li { padding-inline-start:.6rem; border-inline-start:2px solid var(--paper-accent); }
.hero-art { padding:.75rem; background:var(--paper-sheet); border:1px solid var(--paper-line); box-shadow:var(--paper-shadow); transform:rotate(1deg); }
.hero-art img { width:100%; height:auto; display:block; }
.hero-visual-stack { min-width:0; }
.hero-insight-card { position:relative; background:var(--paper-sheet); padding:1.5rem; margin-block-start:1.5rem; margin-inline-start:1.5rem; border:1px solid var(--paper-line); border-block-start:3px solid var(--paper-accent); box-shadow:var(--paper-shadow); }
.story-beat + .story-beat { margin-block-start:1rem; padding-block-start:1rem; border-block-start:1px solid var(--paper-line); }
.story-beat strong,.story-beat h2,.story-beat h3 { font:500 1.35rem/1.25 var(--paper-serif); margin-block:0 .5rem; }
.story-beat span { display:block; color:var(--paper-muted); font-size:.7rem; text-transform:uppercase; letter-spacing:.1em; margin-block-end:.5rem; }
.story-beat p { font-size:.9rem; color:var(--paper-muted); line-height:1.7; margin:0; }
.consulting-section,.trust-section,.consulting-cta { margin-block:0; padding-block:3rem; }
.trust-section { padding-block:2.5rem; border-block:1px solid var(--paper-line); }
.trust-grid,.proof-grid,.process-grid,.about-grid,.cta-grid { display:grid; grid-template-columns:1fr 1.3fr; gap:3rem; }
.trust-grid h2,.section-heading h2,.process-grid h2,.signup-copy h2,.consulting-cta h2 { font:500 clamp(2rem,3.5vw,3rem)/1.15 var(--paper-serif); letter-spacing:-.025em; margin-block:.75rem 1.2rem; }
.trust-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; margin-block-start:2rem; }
.trust-metric { border-inline-start:2px solid var(--paper-blue); padding-inline-start:1.25rem; }
.trust-metric strong { display:block; font:500 2rem/1.3 var(--paper-serif); color:var(--paper-ink); }
.trust-metric span,.trust-metric p { color:var(--paper-muted); font-size:.8rem; line-height:1.6; }
.section-heading { max-width:52rem; margin-block-end:2rem; }
.section-heading p:not(.eyebrow) { color:var(--paper-muted); line-height:1.7; }
.featured-services { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.5rem; }
.featured-card,.service-card { display:flex; flex-direction:column; gap:.7rem; position:relative; min-width:0; padding:1.5rem; border:1px solid var(--paper-line); background:var(--paper-sheet); box-shadow:var(--paper-shadow); color:var(--paper-ink); text-decoration:none; transition:transform 180ms; }
.featured-card:hover,.service-card:hover { transform:translateY(-3px); }
.card-image,.supporting-image { margin:-.75rem -.75rem .5rem; padding:.4rem; background:var(--paper-desk); aspect-ratio:1.9; overflow:hidden; }
.card-image img,.supporting-image img { display:block; width:100%; height:100%; object-fit:cover; }
.featured-card h3,.service-card h3 { font:500 1.7rem/1.2 var(--paper-serif); margin:0; }
.featured-card p,.service-card p { line-height:1.7; margin:0; }
.featured-card p:not(.card-kicker),.service-card p:not(.card-kicker) { font-size:.9rem; color:var(--paper-muted); }
.service-mark { display:grid; place-items:center; width:2.5rem; height:2.5rem; background:var(--paper-blue); color:var(--paper-on-blue); font-size:.8rem; }
.card-link { margin-block-start:auto; padding-block-start:1rem; color:var(--paper-accent); font-size:.8rem; font-weight:600; }
.service-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; margin-block-start:1.5rem; }
.service-grid .service-card h3 { font-size:1.4rem; }
.proof-section { border-block-start:1px solid var(--paper-line); }
.case-stack { display:grid; gap:1.5rem; }
.case-card { padding:1.75rem; background:var(--paper-sheet); border:1px solid var(--paper-line); border-inline-start:4px solid var(--paper-accent); box-shadow:var(--paper-shadow); }
.case-card h3 { font:500 1.65rem/1.3 var(--paper-serif); margin-block:.75rem; }
