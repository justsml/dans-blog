---
import { getEntry, render } from "astro:content";
import { warmDesigns, type Design } from "../../../design-lab/designs";
import { getLabSample } from "../../../design-lab/posts";
import Post from "../../../design-lab/Post.astro";
import type { ArticlePost } from "../../../types";
export function getStaticPaths() {
  return warmDesigns.flatMap(({ id }) => getLabSample().map((post) => ({ params: { design: id, slug: post.baseSlug ?? post.slug }, props: { design: id, post } })));
}
interface Props { design: Design; post: ArticlePost }
const { design, post } = Astro.props;
const entry = await getEntry("posts", post.id);
if (!entry) throw new Error(`Missing preview article: ${post.id}`);
const { Content, headings } = await render(entry);
---
<Post design={design} post={post} headings={headings}><Content /></Post>
