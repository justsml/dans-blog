---
import { ContactForm } from "../components/ContactForm";
import { SITE_DESCRIPTION } from "../consts";
import Layout from "../layouts/Page.astro";
import { DEFAULT_LOCALE, type Locale } from "../shared/i18n";
import { getUiCopy } from "../shared/uiTranslations";

const reCaptchaSiteKey =
  import.meta.env.SITE_RECAPTCHA_KEY ||
  import.meta.env.PUBLIC_SITE_RECAPTCHA_KEY ||
  import.meta.env.VITE_SITE_RECAPTCHA_KEY ||
  import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ||
  import.meta.env.VITE_RECAPTCHA_SITE_KEY ||
  import.meta.env.RECAPTCHA_SITE_KEY ||
  "";
const locale = (Astro.props.locale ?? DEFAULT_LOCALE) as Locale;
const copy = getUiCopy(locale);
---

<Layout
  frontmatter={{
    title: copy.contact.title,
    subTitle: copy.site.description || SITE_DESCRIPTION,
  }}
  description={`${copy.contact.title} ${copy.site.description || SITE_DESCRIPTION}`}
  locale={locale}
  className="article"
>
  <section class="utility-sheet">
  <ContactForm reCaptchaSiteKey={reCaptchaSiteKey} locale={locale}>
    <h1>{copy.contact.heading}</h1>
  </ContactForm>
  </section>
</Layout>

<script>
  import "../scripts/contactForm";
</script>

<style>
.utility-sheet { background:var(--paper-sheet); padding:clamp(1.5rem,5vw,3.5rem); border:1px solid var(--paper-line); border-block-start:4px solid var(--paper-blue); box-shadow:var(--paper-shadow); min-width:0; }
.utility-sheet h1 { margin-block:0 1.5rem; }
.utility-sheet p { line-height:1.8; }
.utility-eyebrow { color:var(--paper-accent); font-size:.75rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
.text-center { margin-block-start:2rem; padding-block-start:1rem; border-block-start:1px solid var(--paper-line); }

.utility-sheet :global(.contact-form) { display:grid; grid-template-columns:1fr; gap:1.25rem; max-width:600px; margin:1.5rem auto 0; }
.utility-sheet :global(.contact-form .bot-food),
.utility-sheet :global(.contact-form .success-message),
.utility-sheet :global(.contact-form .error-message),
.utility-sheet :global(.contact-form .loading-message) { display:none; }
.utility-sheet :global(.contact-form .columns-all) { grid-column:1 / -1; }
.utility-sheet :global(.contact-form .form-item) { min-width:0; margin:0; }
.utility-sheet :global(.contact-form label) { color:var(--paper-ink); font-size:.85rem; font-weight:600; }
.utility-sheet :global(.contact-form input),.utility-sheet :global(.contact-form textarea) { width:100%; min-height:44px; background:var(--paper-raised); color:var(--paper-ink); border:1px solid var(--paper-line); padding:.8rem; }
.utility-sheet :global(.contact-form textarea) { min-height:150px; }
.utility-sheet :global(.contact-form > button) { grid-column:1 / -1; min-height:44px; background:var(--paper-blue); color:var(--paper-on-blue); border:1px solid var(--paper-blue); padding:.9rem 1.2rem; font-size:.9rem; font-weight:600; }
.utility-sheet :global(.contact-form.loading .loading-message) { display:flex; justify-content:center; padding:1rem; color:var(--paper-muted); }
.utility-sheet :global(.contact-form.loading > button) { opacity:.65; pointer-events:none; }
.utility-sheet :global(.contact-form.success .form-item),
.utility-sheet :global(.contact-form.success > button),
.utility-sheet :global(.contact-form.success [data-recaptcha-site-key]) { display:none; }
.utility-sheet :global(.contact-form.success .success-message) { display:block; padding:1rem; border-inline-start:3px solid var(--paper-success); color:var(--paper-success); background:var(--paper-desk); }
.utility-sheet :global(.contact-form.failure .error-message) { display:block; padding:1rem; border-inline-start:3px solid var(--paper-error); color:var(--paper-error); background:var(--paper-desk); }
.utility-sheet :global(.contact-form.failure .success-message) { display:none; }
@media(min-width:600px) { .utility-sheet :global(.contact-form) { grid-template-columns:1fr 1fr; } }
</style>
