---
import Layout from "../../layouts/Page.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  INTRO_CALL_LINK,
  type ConsultingService,
  consultingServices,
  consultingServicesBySlug,
} from "../../data/consultingServices";
import serviceAiConsultingImage from "../../assets/consulting/service-ai-consulting-v2.webp";
import serviceAiGuardrailsImage from "../../assets/consulting/service-ai-guardrails-v2.webp";
import serviceCodingSecurityImage from "../../assets/consulting/service-coding-security-v2.webp";
import serviceEnterpriseSecurityImage from "../../assets/consulting/service-enterprise-security-v2.webp";
import serviceRagImage from "../../assets/consulting/service-rag-v2.webp";
import serviceSupabaseImage from "../../assets/consulting/service-supabase-v2.webp";
import { DEFAULT_LOCALE, getLocalizedPagePath, type Locale } from "../../shared/i18n";

interface Props {
  service?: ConsultingService;
  locale?: Locale;
}

const props = Astro.props as Props;
const service = props.service ??
  consultingServicesBySlug.get(Astro.params.service ?? "");
const locale = (props.locale ?? DEFAULT_LOCALE) as Locale;
const pagePath = (path: string) => getLocalizedPagePath(path, locale);

if (!service) {
  throw new Error(`Unknown consulting service: ${Astro.params.service}`);
}

const relatedServices = consultingServices.filter(
  (entry) => entry.slug !== service.slug,
).slice(0, 3);

const heroPanelImageSizes = "(max-width: 900px) calc(100vw - 3rem), 500px";

const serviceVisuals: Record<string, { accent: string; image: ImageMetadata }> = {
  "ai-consulting": {
    accent: "cyan",
    image: serviceAiConsultingImage,
  },
  "ai-guardrails": {
    accent: "coral",
    image: serviceAiGuardrailsImage,
  },
  "supabase-scaling-migration": {
    accent: "amber",
    image: serviceSupabaseImage,
  },
  "rag-rescue": {
    accent: "cyan",
    image: serviceRagImage,
  },
  "developer-ai-coding-security": {
    accent: "coral",
    image: serviceCodingSecurityImage,
  },
  "enterprise-security-assessment": {
    accent: "amber",
    image: serviceEnterpriseSecurityImage,
  },
};

const serviceVisual = serviceVisuals[service.slug] ?? serviceVisuals["ai-consulting"];
---

{/* English in every locale: one canonical page, no hreflang twins. */}
<Layout
  frontmatter={{
    title: service.metaTitle,
    subTitle: service.description,
  }}
  locale={locale}
  canonicalPath={`/consulting/${service.slug}/`}
  alternates={[]}
  pagefindBody
>
  <section class="service-hero full-section">
    <div class="service-shell">
      <div class="hero-copy">
        <p class="eyebrow">{service.kicker}</p>
        <h1>{service.heroTitle}</h1>
        <p class="hero-body">{service.heroBody}</p>
        <div class="hero-actions">
          <a href={INTRO_CALL_LINK} class="btn btn-primary" target="_blank" rel="noopener">
            {service.primaryCta} →
          </a>
          <a href={pagePath("/consulting/")} class="btn btn-secondary">
            {service.secondaryCta}
          </a>
        </div>
      </div>
      <div class={`hero-panel ${serviceVisual.accent}`}>
        <div class="hero-panel-image" aria-hidden="true">
          <Image
            src={serviceVisual.image}
            alt={`${service.navTitle} consulting visual`}
            widths={[480, 720, 960, 1280, 1586]}
            sizes={heroPanelImageSizes}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <p class="panel-kicker">Best fit</p>
        <h2>{service.title}</h2>
        <ul class="panel-list">
          {service.deliverables.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="service-stats full-section">
    <div class="service-shell">
      <div class="stats-grid">
        {service.stats.map((stat) => (
          <div class="stat-card">
            <div class="stat-value">{stat.value}</div>
            <p>{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="service-section full-section">
    <div class="service-shell two-col">
      <div>
        <p class="section-label">Why teams call</p>
        <h2>The pattern I keep seeing.</h2>
      </div>
      <div class="stack-list">
        {service.whyNow.map((item) => (
          <article class="info-card">
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="service-section full-section">
    <div class="service-shell two-col">
      <div>
        <p class="section-label">What changes</p>
        <h2>What actually gets better.</h2>
      </div>
      <div class="stack-list">
        {service.outcomes.map((item) => (
          <article class="info-card outcome-card">
            <span class="check">✓</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {service.caseStudy && (
    <section class="service-section full-section">
      <div class="service-shell">
        <div class="case-study">
          <p class="section-label">{service.caseStudy.label}</p>
          <h2>{service.caseStudy.title}</h2>
          <p class="case-body">{service.caseStudy.body}</p>
          <p class="case-highlight">{service.caseStudy.highlight}</p>
        </div>
      </div>
    </section>
  )}

  <section class="service-section full-section">
    <div class="service-shell">
      <p class="section-label">How I work</p>
      <h2>No mystery, no handoff decks.</h2>
      <div class="approach-grid">
        {service.approach.map((step, index) => (
          <article class="approach-card">
            <div class="step-num">0{index + 1}</div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="service-section full-section">
    <div class="service-shell">
      <div class="final-cta">
        <div>
          <p class="section-label">Next step</p>
          <h2>Ready to stop circling it?</h2>
          <p class="cta-copy">
            Bring whatever your team keeps putting off — the scary migration,
            the expensive AI bill, the app that misbehaves in production.
            We'll figure out what's actually blocking it.
          </p>
        </div>
        <a href={INTRO_CALL_LINK} class="btn btn-primary btn-large" target="_blank" rel="noopener">
          {service.primaryCta} →
        </a>
      </div>
    </div>
  </section>

  <section class="service-section full-section related-section">
    <div class="service-shell">
      <p class="section-label">Related services</p>
      <div class="related-grid">
        {relatedServices.map((entry) => (
          <a class="related-card" href={pagePath(`/consulting/${entry.slug}/`)}>
            <span class="related-kicker">{entry.kicker}</span>
            <h3>{entry.navTitle}</h3>
            <p>{entry.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>

.full-section { grid-column:full-width; width:100%; padding:0; }
.service-shell { width:min(1180px,calc(100% - 3rem)); margin-inline:auto; min-width:0; }
.service-hero { padding-block:2.5rem; }
.service-hero .service-shell { display:grid; grid-template-columns:1.2fr 1fr; align-items:start; gap:3rem; }
.hero-copy h1 { font:500 clamp(2.5rem,5vw,4.5rem)/1.08 var(--paper-serif); letter-spacing:-.04em; color:var(--paper-ink); margin-block:.8rem 1.5rem; }
.hero-body { color:var(--paper-muted); font-size:1.1rem; line-height:1.75; }
.eyebrow,.section-label,.panel-kicker,.related-kicker { color:var(--paper-accent); text-transform:uppercase; letter-spacing:.12em; font-size:.7rem; font-weight:700; }
.hero-actions { display:flex; gap:.75rem; flex-wrap:wrap; margin-block:1.5rem; }
.btn { display:inline-flex; align-items:center; justify-content:center; gap:.75rem; min-height:44px; padding:.9rem 1.2rem; border:1px solid var(--paper-line); color:var(--paper-ink); background:var(--paper-sheet); text-decoration:none; font-size:.85rem; font-weight:600; }
.btn-primary { background:var(--paper-blue); border-color:var(--paper-blue); color:var(--paper-on-blue); }
.hero-panel { padding:1.5rem; border:1px solid var(--paper-line); border-block-start:4px solid var(--paper-accent); background:var(--paper-sheet); box-shadow:var(--paper-shadow); }
.hero-panel-image { margin-block-end:1.5rem; padding:.5rem; background:var(--paper-desk); }
.hero-panel-image img { width:100%; height:auto; display:block; }
.hero-panel h2 { font:500 1.6rem/1.2 var(--paper-serif); }
.panel-list { padding-inline-start:1.2rem; color:var(--paper-muted); line-height:1.7; }
.panel-list li { margin-block:.6rem; }
.service-stats { padding-block:1.5rem 2rem; border-block-end:1px solid var(--paper-line); }
.stats-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; }
.stat-card { padding:1rem 1.5rem; border-inline-start:2px solid var(--paper-blue); }
.stat-value { font:500 2.2rem/1.2 var(--paper-serif); color:var(--paper-ink); }
.stat-card p { color:var(--paper-muted); font-size:.85rem; line-height:1.6; }
.service-section { padding-block:2.5rem; }
.two-col { display:grid; grid-template-columns:1fr 1.4fr; gap:3rem; }
.service-section h2 { font:500 clamp(1.8rem,3.5vw,2.7rem)/1.2 var(--paper-serif); margin-block:.75rem 1.5rem; }
.stack-list { display:grid; gap:1rem; }
.info-card { background:var(--paper-sheet); padding:1.5rem; border:1px solid var(--paper-line); box-shadow:var(--paper-shadow); }
.info-card h3 { font:500 1.4rem/1.2 var(--paper-serif); margin-block:0 .7rem; }
.info-card p,.case-body,.cta-copy { color:var(--paper-muted); line-height:1.7; margin:0; }
.outcome-card { display:grid; grid-template-columns:auto 1fr; gap:1rem; }
.check { color:var(--paper-accent); font-size:1.2rem; }
.case-study { padding:clamp(1.5rem,4vw,3rem); background:var(--paper-sheet); border:1px solid var(--paper-line); border-inline-start:4px solid var(--paper-accent); box-shadow:var(--paper-shadow); }
.case-highlight { color:var(--paper-ink); padding-block-start:1rem; border-block-start:1px solid var(--paper-line); }
.approach-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; }
.approach-card { padding:1.5rem; background:var(--paper-sheet); border:1px solid var(--paper-line); box-shadow:var(--paper-shadow); }
.approach-card h3 { font:500 1.4rem/1.3 var(--paper-serif); }
.approach-card p { color:var(--paper-muted); font-size:.9rem; line-height:1.7; }
.step-num { color:var(--paper-accent); font:500 2rem var(--paper-serif); }
.final-cta { display:grid; grid-template-columns:1fr auto; align-items:center; gap:2rem; padding:2rem; background:var(--paper-sheet); border:1px solid var(--paper-line); border-block-start:4px solid var(--paper-blue); box-shadow:var(--paper-shadow); }
.related-section { border-block-start:1px solid var(--paper-line); }
.related-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; }
.related-card { background:var(--paper-sheet); border:1px solid var(--paper-line); padding:1.5rem; color:var(--paper-ink); text-decoration:none; box-shadow:var(--paper-shadow); }
.related-card h3 { font:500 1.4rem/1.3 var(--paper-serif); }
.related-card p { font-size:.9rem; line-height:1.7; color:var(--paper-muted); }
@media(max-width:900px) { .service-hero .service-shell,.two-col { grid-template-columns:1fr; gap:1.5rem; } .hero-panel { max-width:600px; } .approach-grid,.related-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media(max-width:600px) { .service-shell { width:calc(100% - 2rem); } .stats-grid,.approach-grid,.related-grid,.final-cta { grid-template-columns:1fr; } .service-section { padding-block:2rem; } .final-cta { padding:1.5rem; } }

</style>
