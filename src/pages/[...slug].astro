---
import Post from "../layouts/Post.astro";
import { render, type CollectionEntry } from "astro:content";
import { PostCollections } from "../shared/postsCache";
import { writeRedirectManifest } from "../scripts/redirectManager";
import type { Locale } from "../shared/i18n";
import { getReadingTimeMinutes } from "../shared/readingTime";
import { postMetaDescription } from "../shared/metaDescription";

export async function getStaticPaths() {
  const paths = PostCollections.getStaticPaths();
  writeRedirectManifest([
    ...PostCollections.getRedirectSourcePosts(),
    ...PostCollections.getMissingTranslationRedirectSourcePosts(),
  ]);
  return paths;
}

type Props = CollectionEntry<"posts"> & {
  slug: string;
  baseSlug?: string;
  locale?: Locale;
  isTranslation?: boolean;
};

const post = Astro.props as Props;
const results = await render(post);
const { Content, headings } = results;
const readingTimeMinutes = getReadingTimeMinutes(post.body);
// The word-based estimate undercounts CJK text. Keep navigation available
// whenever the source article qualifies, while linking localized headings.
const sourcePost = PostCollections._postsBySlug[post.baseSlug ?? post.slug];
const tocReadingTimeMinutes = Math.max(readingTimeMinutes, getReadingTimeMinutes(sourcePost?.body));
---

<Post
  sourcePath={post.id}
  slug={post.slug}
  baseSlug={post.baseSlug}
  locale={post.locale}
  isTranslation={post.isTranslation}
  frontmatter={{ ...post.data }}
  readingTimeMinutes={readingTimeMinutes}
  tocReadingTimeMinutes={tocReadingTimeMinutes}
  metaDescription={postMetaDescription(post.data.subTitle, post.body)}
  headings={headings}
>
  <Content />
</Post>
