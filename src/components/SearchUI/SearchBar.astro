---
import "./search.css";

type Props = {
  className?: string;
  showImages?: boolean;
  pageSize?: number;
};

const { showImages = true, pageSize = 25, className } = Astro.props;
---

<div id="site-search-panel" role="dialog" aria-label="Search articles" inert class:list={["searchBar", "collapsed", className]}>
  <div class="search-panel-toolbar"><span>Search articles</span><button type="button" class="search-panel-close" aria-label="Close search">✕</button></div>
  <div
    id="search"
    class="pagefind-ui pagefind-init"
    data-bundle-path="/pagefind/"
    data-page-size={pageSize}
    data-show-images={showImages ? "true" : "false"}
  ></div>
</div>
