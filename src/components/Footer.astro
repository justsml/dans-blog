---
import {
  ArrowUpRightIcon,
  CopyIcon,
  QuoteIcon,
  RssIcon,
  Share2Icon,
} from "lucide-react";
import { INTRO_CALL_LINK } from "../data/consultingServices";
import { PostCollections } from "../shared/postsCache";
import type { ArticlePost } from "../types";
import { EditOnGitHubLink } from "./EditOnGitHubLink";
import SocialLinks from "./SocialLinks.astro";
import SubscribeForm from "./SubscribeForm.astro";
import { DEFAULT_LOCALE, type Locale } from "../shared/i18n";
import { getUiCopy } from "../shared/uiTranslations";
import { optimizeArticleCardImage } from "../shared/articleImages";

type Props = {
  showSubscribeForm?: boolean;
  slugs?: string[];
  excludeSlugs?: string[];
  articleLimit?: number;
  tags?: string[];
  category?: string;
  currentSlug?: string;
  locale?: Locale;
  editSourcePath?: string;
}

const {
  showSubscribeForm = false,
  articleLimit = 4,
  excludeSlugs = [],
  tags = [],
  category,
  currentSlug,
  locale = DEFAULT_LOCALE,
  editSourcePath,
} = Astro.props as Props;
const copy = getUiCopy(locale);

const today = new Date();

const popularPosts = PostCollections.getPopularPosts() as ArticlePost[];
const recentPosts = PostCollections.getRecentPosts(8) as ArticlePost[];
let slugs = Astro.props.slugs ?? [];

if (slugs.length < articleLimit) {
  slugs = getRelatedArticleSlugs(slugs, articleLimit, tags, category, currentSlug);
}

slugs = addFallbackArticleSlugs(slugs, articleLimit);

const footerArticles = await Promise.all(PostCollections.getPostsBySlugs(slugs).map(post => optimizeArticleCardImage(post as ArticlePost)));

function getRelatedArticleSlugs(
  currentSlugs: string[],
  limit: number,
  currentTags: string[],
  currentCategory?: string,
  activeSlug?: string,
) {
  const posts = PostCollections.getPosts() as ArticlePost[];
  const scoredPosts = posts
    .filter((post) => (
      post.slug !== activeSlug &&
      !excludeSlugs.includes(post.slug) &&
      !currentSlugs.includes(post.slug) &&
      !post.data.draft &&
      !post.data.hidden
    ))
    .map((post) => {
      const matchingTags = post.data.tags?.filter((tag) => currentTags.includes(tag)).length ?? 0;
      const categoryScore = currentCategory && post.data.category === currentCategory ? 3 : 0;
      return { post, score: categoryScore + matchingTags };
    })
    .filter((item) => item.score > 0)
    .sort((a, b) => b.score - a.score);

  const slotsForRelated = Math.max(0, limit - 2);

  for (const item of scoredPosts) {
    if (currentSlugs.length >= slotsForRelated) break;
    currentSlugs.push(item.post.slug);
  }

  return currentSlugs;
}

function addFallbackArticleSlugs(currentSlugs: string[], limit: number) {
  const fallbackPosts = [...popularPosts, ...recentPosts];

  for (const post of fallbackPosts) {
    if (currentSlugs.length >= limit) break;
    if (!post || post.slug === currentSlug) continue;
    if (excludeSlugs.includes(post.slug) || currentSlugs.includes(post.slug)) continue;
    if (post.data.draft || post.data.hidden) continue;
    currentSlugs.push(post.slug);
  }

  return currentSlugs.slice(0, limit);
}

function getArticleImage(article: ArticlePost) {
  if (article.cardImage) return article.cardImage.src;
  const icon = article.data.cover_mobile;
  if (typeof icon === "string") return icon;
  if (icon && typeof icon === "object" && "src" in icon) return icon.src;
  return "";
}

function getArticleHref(article: ArticlePost) {
  return PostCollections.getLocalizedPostHref(article, locale);
}
---

<footer class="content-grid site-footer" role="contentinfo" data-pagefind-ignore="all">
  <div class="site-footer__grid">
    <section class="footer-card footer-card--rss" aria-labelledby="footer-rss-title">
      <p class="footer-kicker" id="footer-rss-title">{copy.footer.feeds}</p>
      <a class="footer-feed-link" href="/rss.xml">
        <RssIcon size="1.2em" strokeWidth={1.8} />
        <span>{copy.footer.rssFeed}</span>
        <ArrowUpRightIcon size="1em" strokeWidth={1.8} />
      </a>
      <a class="footer-feed-link footer-feed-link--quiet" href="/rss.json">
        <CopyIcon size="1.05em" strokeWidth={1.8} />
        <span>{copy.footer.jsonFeed}</span>
        <ArrowUpRightIcon size="1em" strokeWidth={1.8} />
      </a>
    </section>

    <section class="footer-card footer-card--quote" aria-labelledby="footer-quote-title">
      <div class="footer-card__marker" aria-hidden="true">
        <QuoteIcon size="1.15em" strokeWidth={1.7} />
      </div>
      <p class="footer-kicker" id="footer-quote-title">{copy.footer.quotable}</p>
      <blockquote>
        <p>{copy.footer.quote}</p>
        <cite>
          <a href="https://wesbos.com/" target="_blank" rel="noopener noreferrer">Wes Bos</a>
          <span>{copy.footer.from}</span>
          <a href="https://syntax.fm/" target="_blank" rel="noopener noreferrer">Syntax.fm</a>
        </cite>
      </blockquote>
    </section>

    <section class="footer-card footer-card--connect" aria-labelledby="footer-connect-title">
      <p class="footer-kicker" id="footer-connect-title">{copy.footer.elsewhere}</p>
      <h2>{copy.footer.follow}</h2>
      <SocialLinks />
      <button class="footer-action" type="button" data-footer-share data-footer-share-copied={copy.footer.copied}>
        <Share2Icon size="1.05em" strokeWidth={1.8} />
        <span data-footer-share-label>{copy.footer.share}</span>
      </button>
    </section>

    <section class="footer-card footer-card--cta" aria-labelledby="footer-cta-title">
      <p class="footer-kicker">{copy.footer.consulting}</p>
      <h2 id="footer-cta-title">{copy.footer.ctaTitle}</h2>
      <p>{copy.footer.ctaText}</p>
      <a class="footer-cta-link" href={INTRO_CALL_LINK} target="_blank" rel="noopener">
        <span>{copy.footer.bookCall}</span>
        <ArrowUpRightIcon size="1em" strokeWidth={1.8} />
      </a>
    </section>

    <section class="footer-card footer-card--reading" aria-labelledby="footer-reading-title">
      <div class="footer-card__heading">
        <p class="footer-kicker">{copy.footer.related}</p>
        <h2 id="footer-reading-title">{copy.footer.readMore}</h2>
      </div>
      <div class="footer-article-grid">
        {
          footerArticles.map((article) => (
            <a class="footer-article-card" href={getArticleHref(article)}>
              {getArticleImage(article) && (
                <span class="footer-article-card__media">
                  <img
                    src={getArticleImage(article)}
                    srcset={article.cardImage?.srcSet}
                    sizes="(max-width: 600px) calc(100vw - 6rem), (max-width: 1180px) calc((100vw - 10rem) / 2), 352px"
                    width={article.cardImage?.width}
                    height={article.cardImage?.height}
                    alt={`${article.data.title} ${copy.footer.coverAltSuffix}`}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
              <span class="footer-article-card__category">{article.data.category}</span>
              <span class="footer-article-card__title">{article.data.title}</span>
              <ArrowUpRightIcon size="1em" strokeWidth={1.8} aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </section>

    {
      showSubscribeForm && (
        <section class="footer-card footer-card--subscribe" aria-label={copy.footer.subscribe}>
          <SubscribeForm />
        </section>
      )
    }

    <section class="footer-card footer-card--meta" aria-label={copy.footer.credits}>
      {
        editSourcePath && (
          <EditOnGitHubLink
            sourcePath={editSourcePath}
            repoUri="https://github.com/justsml/dans-blog/tree/main/src/content/posts"
          />
        )
      }
      <p>
        &copy; 2008-{today.getFullYear()}{" "}
        <a href="https://danlevy.net/">Dan Levy</a>
      </p>
      <p>{copy.footer.rights}<br />🇿🇦 🇮🇪 🇬🇧 🇺🇸.</p>
    </section>
  </div>
</footer>

<script is:inline data-astro-rerun>
  (() => {
    const buttons = document.querySelectorAll("[data-footer-share]");
    if (!buttons.length) return;

    buttons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement) || button.dataset.footerShareReady === "true") {
        return;
      }

      button.dataset.footerShareReady = "true";
      const label = button.querySelector("[data-footer-share-label]");
      const defaultText = label?.textContent || "Share this page";
      const copiedText = button.dataset.footerShareCopied || "Copied link";

      button.addEventListener("click", async () => {
        const url = window.location.href;
        const title = document.title || "DanLevy.net";

        try {
          if (navigator.share) {
            await navigator.share({ title, url });
          } else {
            await navigator.clipboard.writeText(url);
            if (label) label.textContent = copiedText;
            window.setTimeout(() => {
              if (label) label.textContent = defaultText;
            }, 1_600);
          }
        } catch {
          if (label) label.textContent = defaultText;
        }
      });
    });
  })();
</script>

<style>

.site-footer { --content-max-width:1180px; --breakout-max-width:1180px; --padding-inline:1.5rem; margin-block-start:clamp(4rem,8vw,7rem); padding-block:3rem; border-block-start:1px solid var(--paper-line); color:var(--paper-ink); }
.site-footer__grid { grid-column:content; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; padding:0; }
.footer-card { padding:1.6rem; background:var(--paper-sheet); border:1px solid var(--paper-line); box-shadow:var(--paper-shadow); display:flex; flex-direction:column; gap:1rem; min-width:0; }
.footer-card--reading { grid-column:2 / 4; grid-row:2 / 4; }
.footer-card--quote { grid-column:1; grid-row:2; border-block-start:4px solid var(--paper-accent); }
.footer-card--rss { border-block-start:4px solid var(--paper-blue); }
.footer-card h2 { color:var(--paper-ink); font:500 clamp(1.5rem,2.8vw,2rem)/1.15 var(--paper-serif); margin:0; }
.footer-kicker { color:var(--paper-accent); font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.13em; margin:0; }
.footer-card p { margin:0; line-height:1.65; }
.footer-card p:not(.footer-kicker),cite { color:var(--paper-muted); }
.footer-card a { color:inherit; text-decoration:none; }
.footer-card a:hover { color:var(--paper-accent); }
.footer-card__marker { color:var(--paper-accent); }
blockquote { border:0; padding:0; margin:0; }
blockquote p { font:italic 1.45rem/1.4 var(--paper-serif); color:var(--paper-ink) !important; }
cite { display:flex; flex-wrap:wrap; gap:.4rem; font-size:.75rem; font-style:normal; margin-block-start:1rem; }
.footer-card :global(.social-links) { display:flex; flex-wrap:wrap; gap:.6rem; height:auto; justify-content:flex-start; margin:0; padding:0; }
.footer-card :global(.social-links a) { display:grid; place-items:center; width:44px; height:44px; border:1px solid var(--paper-line); background:var(--paper-desk); color:var(--paper-ink); }
.footer-card :global(.social-links .icon) { width:20px; height:20px; margin:0; opacity:1; }
.footer-action,.footer-feed-link,.footer-cta-link,.footer-reading-link { display:flex; align-items:center; gap:.65rem; min-height:44px; font-size:.85rem; font-weight:600; line-height:1.3; color:var(--paper-blue); border:0; border-block-end:1px solid var(--paper-line); background:transparent; text-align:start; padding:.65rem 0; }
.footer-action { cursor:pointer; align-self:flex-start; }
.footer-feed-link svg:last-child { margin-inline-start:auto; }
.footer-article-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
.footer-article-card { display:grid; grid-template-columns:1fr auto; gap:.65rem; padding:.9rem; background:var(--paper-desk); border:1px solid var(--paper-line); color:var(--paper-ink); transition:transform 180ms; }
.footer-article-card:hover { transform:translateY(-2px); }
.footer-article-card__category { font-size:.65rem; color:var(--paper-accent); text-transform:uppercase; letter-spacing:.07em; }
.footer-article-card__title { grid-column:1 / -1; font:500 1.2rem/1.25 var(--paper-serif); overflow-wrap:anywhere; }
.footer-article-card > svg { grid-column:2; grid-row:1; }
.footer-article-card__media { grid-column:1 / -1; aspect-ratio:16 / 9; display:block; overflow:hidden; }
.footer-article-card__media img { width:100%; height:100%; object-fit:cover; }
.footer-card--meta { font-size:.8rem; }
.footer-card--meta :global(.edit-on-github) { color:var(--paper-blue); justify-content:flex-start; }
@media(max-width:900px) { .site-footer__grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .footer-card--reading { grid-column:1 / -1; grid-row:auto; } .footer-card--quote { grid-row:auto; } }
@media(max-width:600px) { .site-footer { --padding-inline:1rem; padding-block:2rem; } .site-footer__grid { grid-template-columns:1fr; gap:1rem; } .footer-card { padding:1.25rem; } .footer-article-grid { grid-template-columns:1fr; } }
@media(prefers-reduced-motion:reduce) { .footer-article-card { transition:none; } }

</style>
