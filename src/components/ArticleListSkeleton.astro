---
type Props = {
  nextUrl?: string | null;
};

const { nextUrl } = Astro.props as Props;
---

{
  nextUrl && (
    <div
      class="article-list-loader"
      hx-get={nextUrl}
      hx-trigger="click"
      hx-swap="outerHTML"
    >
      <button class="article-list-loader__button" type="button">More posts</button>
    </div>
  )
}
