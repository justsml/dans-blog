---
import { SiteAuthors } from "../../components/Seo/SchemaData";

type Props = {
  locale?: string;
  title: string;
  description: string;
  date: string;
  modified: string;
  slug: string;
  tags: string;
  imageUrl?: string | ImageMetadata;
  /** The page's canonical path, so `url` and `@id` match <link rel="canonical"> exactly. */
  canonicalPath?: string;
};

let {
  locale = "en-US",
  title,
  description,
  date,
  modified,
  slug,
  tags,
  imageUrl,
  canonicalPath,
} = Astro.props as Props;

// Structured data wants absolute URLs; built image paths are site-relative.
const site = Astro.site ?? new URL("https://danlevy.net");
const imagePath = typeof imageUrl === "string" ? imageUrl : (imageUrl?.src ?? "");
const image = imagePath ? new URL(imagePath, site).href : undefined;
const url = new URL(canonicalPath ?? `/${slug}/`, site).href;

let schema = {
  "@context": "https://schema.org/",
  "@type": "BlogPosting",
  headline: title,
  author: SiteAuthors.justsml,
  copyrightYear: getYear(date),
  datePublished: date,
  dateCreated: date,
  dateModified: modified,
  description: description,
  url,
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  publisher: { "@type": "Person", name: SiteAuthors.justsml.name, url: SiteAuthors.justsml.url },
  inLanguage: locale,
  image,
  keywords: tags,
};

function getYear(date: string) {
  return new Date(date).getFullYear();
}

const isProduction = process.env.NODE_ENV === "production";
const generatedSchema = isProduction
  ? JSON.stringify(schema)
  : JSON.stringify(schema, null, 2);
---

<script type="application/ld+json" set:html={generatedSchema} is:inline />
