---
import Page from "../layouts/Page.astro";
import PaperArtwork from "./PaperArtwork.astro";

import { optimizeArticleCardImage } from "../shared/articleImages";
import { PostCollections } from "../shared/postsCache.ts";
import { ArticleCard } from "./ArticleCard";
import ArticleListSkeleton from "./ArticleListSkeleton.astro";
// import FloatingLines from "./FloatingLines";
import type { ArticlePost } from "../types";
import omit from "lodash/omit";
import { pageSize } from "../shared/pagination";
import { getListedArchivePosts, sortArchivePosts } from "../shared/archivePagination";
import "@/styles/nav.css";
import "@/styles/global.css";
import { SITE_SEO_DESCRIPTION, SITE_TITLE } from "../consts.ts";
import { DEFAULT_LOCALE, getLocalizedPagePath, type Locale } from "../shared/i18n";
import { getUiCopy } from "../shared/uiTranslations";

// import ArticleFilterLinks from "../components/ArticleFilterLinks.astro";

const locale = (Astro.props.locale ?? DEFAULT_LOCALE) as Locale;
const copy = getUiCopy(locale);

let posts = sortArchivePosts(
  getListedArchivePosts(PostCollections.getPostsForLocale(locale)),
  { field: "date", direction: "desc" },
).map((p) =>
  omit(p as ArticlePost, [
    "data.body",
    "data.cover",
    "data.cover_icon",
  ])
)
.filter((p) => !p.data?.unlisted && !p.data?.hidden) as ArticlePost[];

const hasMorePosts = posts.length > pageSize;
const defaultNextUrl = hasMorePosts
  ? locale === DEFAULT_LOCALE
    ? "/pages/2-date-desc/"
    : `/${locale}/pages/2-date-desc/`
  : null;

posts = posts.slice(0, pageSize);
posts = await Promise.all(posts.map((post, index) => optimizeArticleCardImage(post, index === 0)));

const defaultFullTitle = copy.home.title || `${SITE_TITLE} | ${SITE_SEO_DESCRIPTION}`;

---

<Page title={defaultFullTitle} subTitle={copy.site.seoDescription} className="home-page" locale={locale}>
  <section class="home-explainer" aria-labelledby="home-title">
    <div class="home-copy">
    <p class="eyebrow">{copy.home.eyebrow}</p>
    <h1 id="home-title">{copy.home.heading}</h1>
    <p>
      {copy.home.intro}
    </p>
    </div>
    <PaperArtwork />
  </section>

  <section class="home-link-spotlight" aria-labelledby="home-link-spotlight-title">
    <h2 id="home-link-spotlight-title" class="visually-hidden">{copy.home.resourcesTitle}</h2>
    <div class="spotlight-actions" aria-label="Featured links">
      <a class="spotlight-link consulting-link" href={getLocalizedPagePath("/consulting/", locale)}>
        <span class="link-kicker">{copy.home.hireKicker}</span>
        <span class="link-title">{copy.home.hireTitle}</span>
      </a>
      <a class="spotlight-link oss-link" href={getLocalizedPagePath("/open-source-journal/", locale)}>
        <span class="link-kicker">{copy.home.ossKicker}</span>
        <span class="link-title">{copy.home.ossTitle}</span>
      </a>
    </div>
  </section>

  <div class:list={["article-list", "article-list--bento"]} aria-label={copy.home.latestTitle}>
    {
      posts.map((props: any) => (
        <ArticleCard article={props as ArticlePost} width={200} locale={locale} />
      ))
    }
    <ArticleListSkeleton nextUrl={defaultNextUrl} locale={locale} />
  </div>
  <p class="visually-hidden" data-article-loading-status role="status" aria-live="polite" aria-atomic="true"></p>
</Page>

<script is:inline src="/js/htmx.min.js" defer></script>

<style>

:global(main.home-page) { --content-max-width:1180px; --breakout-max-width:1180px; }
.home-explainer { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); align-items:center; gap:clamp(2rem,5vw,5rem); padding-block:2rem 4rem; }
.home-copy { min-width:0; }
.eyebrow,.link-kicker { color:var(--paper-accent); font-size:.72rem; font-weight:700; letter-spacing:.15em; text-transform:uppercase; }
.home-explainer h1 { font:500 clamp(2.6rem,4.8vw,4.5rem)/1.05 var(--paper-serif); letter-spacing:-.045em; color:var(--paper-ink); margin:.9rem 0 1.4rem; text-wrap:balance; }
.home-explainer p:not(.eyebrow) { color:var(--paper-muted); font-size:1.1rem; line-height:1.7; max-width:52ch; }
.home-link-spotlight { margin-block:0 2rem; }
.spotlight-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.25rem; }
.spotlight-link { display:grid; gap:.4rem; padding:1.4rem 1.6rem; border:1px solid var(--paper-line); border-inline-start:4px solid var(--paper-blue); background:var(--paper-sheet); color:var(--paper-ink); text-decoration:none; box-shadow:var(--paper-shadow); transition:transform 180ms; }
.spotlight-link.oss-link { border-inline-start-color:var(--paper-accent); }
.spotlight-link:hover { transform:translateY(-2px); }
.link-title { font:500 1.5rem/1.3 var(--paper-serif); }
.article-list { margin-block:1rem 0; padding-inline:0; }
@media(max-width:700px) { .home-explainer { grid-template-columns:1fr; gap:1.5rem; padding-block:1rem 2rem; } .home-explainer h1 { font-size:clamp(2.5rem,10vw,3.5rem); } .spotlight-actions { grid-template-columns:1fr; } }
@media(prefers-reduced-motion:reduce) { .spotlight-link { transition:none; } }

</style>
