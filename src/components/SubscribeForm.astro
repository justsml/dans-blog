---

---
<section class="subscribe-form">
  <div>
    <div>
      <div>
        <h2>
          Subscribe for more
        </h2>
        <p>
          My (almost) monthly newsletter is overflowing with the best articles, plus some I wrote myself. No spam, unsubscribe any time.
        </p>

        <div>
          <script
            is:inline
            defer
            src="https://unpkg.com/@tryghost/portal@latest/umd/portal.min.js"
            data-ghost="https://cms.ignoreallpreviousinstructions.ai/"
            data-api="https://cms.ignoreallpreviousinstructions.ai/ghost/api/content/"
            data-key="fb511f7995fd31bbb68177cf0c"></script>
          <form data-members-form class="subscribe-form">
            <input
              name="email"
              placeholder="Your email address..."
              type="email"
              autocomplete="email"
              required
              data-members-email
            />
            <button
              type="submit">Subscribe</button
            >
            <strong class="feedback"
              >Thanks for signing up! Please check your inbox to confirm your
              singup.</strong
            >
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.querySelector('form.subscribe-form');
    form?.addEventListener('submit', function (event) {
      event.preventDefault();
      console.log('Form submitted', event.target);
    });
  });
</script>
<style id="subscribe-form-styles">
  .subscribe-form { position:relative; }
  .subscribe-form > div { max-inline-size:48rem; margin-inline:auto; }
  .subscribe-form > div > div > div { padding:1.5rem; background:var(--paper-sheet); border:1px solid var(--paper-line); box-shadow:var(--paper-shadow); text-align:center; }
  .subscribe-form h2 { color:var(--paper-ink); font:500 1.8rem/1.2 var(--paper-serif,Georgia,serif); margin-block:0 1rem; }
  .subscribe-form p { color:var(--paper-muted); font-size:1rem; line-height:1.6; }
  .subscribe-form input[data-members-email] { display:block; inline-size:100%; min-block-size:44px; padding:.75rem; background:var(--paper-sheet); color:var(--paper-ink); border:1px solid var(--paper-line); border-radius:1px; font:inherit; }
  .subscribe-form input[data-members-email]::placeholder { color:var(--paper-muted); }
  .subscribe-form input[data-members-email]:focus-visible,.subscribe-form button:focus-visible { outline:2px solid var(--paper-accent); outline-offset:3px; }
  .subscribe-form button[type="submit"] { margin-block:1rem 0; min-block-size:44px; padding:.75rem 1.5rem; color:var(--paper-on-blue,#fff); background:var(--paper-blue); border:1px solid var(--paper-blue); border-radius:1px; font:inherit; cursor:pointer; }
  .subscribe-form form .feedback { display:none; color:var(--paper-success); font-size:.95rem; }
  .subscribe-form form.success input,.subscribe-form form.success button { display:none!important; }
  .subscribe-form form.success .feedback { display:block; }
</style>
