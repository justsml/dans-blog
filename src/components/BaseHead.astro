---
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import pkg from "../../package.json";
import { SITE_TITLE, SITE_SEO_DESCRIPTION } from "../consts";
import socialBanner from "../assets/social-banner.webp";
import "@/styles/nav.css";
import "@/styles/layout.css";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string | undefined;
  image?: string | ImageMetadata | undefined;
  canonicalPath?: string;
  alternates?: Array<{ locale: string; href: string }>;
  noindex?: boolean;
}

// const slug = Astro.url.pathname.replace(/^\/*|\/*$/g, "");
// const isHomePage = slug === "/" || slug.length < 2;

const {
  canonicalPath = Astro.url.pathname,
  alternates = [],
  noindex = false,
} = Astro.props as Props;

const canonicalURL = new URL(canonicalPath, Astro.site);
const xDefaultHref =
  alternates.find((alternate) => alternate.locale === "en")?.href ??
  canonicalPath;
const xDefaultURL = new URL(xDefaultHref, Astro.site);

let { title, description, image } = Astro.props;

if (description === "undefined") description = undefined;

const META_DESCRIPTION_MAX_LENGTH = 155;

function normalizeMetaDescription(value: string | undefined) {
  if (!value) return undefined;

  const text = value
    .replace(/`([^`]+)`/g, "$1")
    .replace(/<[^>]*>/g, "")
    .replace(/\s+/g, " ")
    .trim();

  if (text.length <= META_DESCRIPTION_MAX_LENGTH) return text;

  const truncated = text
    .slice(0, META_DESCRIPTION_MAX_LENGTH - 3)
    .replace(/\s+\S*$/, "")
    .replace(/[,:;.!?\-]+$/, "");

  return `${truncated}...`;
}

if (
  !image ||
  (typeof image === "string" ? image.length <= 1 : !("src" in image))
) {
  image = socialBanner;
}
const defaultFullTitle = `${SITE_TITLE} | ${SITE_SEO_DESCRIPTION}`;
const siteTitle =
  title === "DanLevy.net" ? defaultFullTitle : `${title} | ${SITE_TITLE}`;
const siteDescription = normalizeMetaDescription(description || SITE_SEO_DESCRIPTION);

const version = pkg.version;

const imgSrc = typeof image === "string" ? image : image?.src;
const imageWidth = typeof image !== "string" ? image?.width : null;
const imageHeight = typeof image !== "string" ? image?.height : null;
---

<meta charset="utf-8" />
<ClientRouter />
<script is:inline data-astro-rerun>
  (() => {
    let value = "system";
    try { const saved = localStorage.getItem("danlevy.theme"); if (saved === "light" || saved === "dark") value = saved; } catch {}
    const resolved = value === "system" ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : value;
    document.documentElement.dataset.theme = resolved;
    document.documentElement.classList.toggle("dark", resolved === "dark");
  })();
</script>
<script>import "../scripts/siteTheme";</script>
<script is:inline>
  // Not data-astro-rerun: ClientRouter swaps <html> attributes on navigation, so only a real first load keeps this class.
  try { if (!sessionStorage.getItem("paper-glow")) { document.documentElement.classList.add("paper-first-load"); sessionStorage.setItem("paper-glow", "1"); } } catch {}
</script>
<style is:inline>
  /* Inlined so the glow paints with the first frame instead of waiting for the bundled stylesheet. */
  body::after { content: ""; position: fixed; z-index: -1; pointer-events: none; inset: 0 auto auto 50%; inline-size: min(120vw, 1500px); aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; background: conic-gradient(from 0deg, var(--paper-glow-a), transparent 22%, var(--paper-glow-b) 45%, transparent 68%, var(--paper-glow-a) 88%, var(--paper-glow-a)); filter: blur(28px); mask-image: radial-gradient(closest-side, #000 35%, transparent); animation: paper-glow-swirl 120s linear infinite; }
  .paper-first-load body::after { animation: paper-glow-rise 900ms cubic-bezier(.55, 0, 1, .45) backwards, paper-glow-swirl 120s linear infinite; }
  @keyframes paper-glow-rise { from { translate: -50% -15%; opacity: 0; } }
  @keyframes paper-glow-swirl { to { rotate: 1turn; } }
  @media (prefers-reduced-motion: reduce) { body::after { animation: none !important; } }
  @media print { body::after { display: none; } }
</style>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="site-version" content={version ?? "0.0.0"} />
<link
  rel="preload"
  href="/fonts/atkinson-regular.woff"
  as="font"
  type="font/woff"
  crossorigin
/>
<link rel="canonical" class="p-url" href={canonicalURL} />
{
  alternates.map((alternate) => (
    <link
      rel="alternate"
      hreflang={alternate.locale}
      href={new URL(alternate.href, Astro.site)}
    />
  ))
}
{
  alternates.length > 0 && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={xDefaultURL}
    />
  )
}
{noindex && <meta name="robots" content="noindex,follow" />}
<link rel="sitemap" href="/sitemap-0.xml" />
<link rel="manifest" href="/manifest.webmanifest" />
{/*Primary Meta Tags*/}
<slot name="title">
  <title class="p-name">{title ?? siteTitle}</title>
  <meta name="title" content={title ?? siteTitle} />
  <meta property="twitter:title" content={title ?? siteTitle} />
  <meta property="og:title" content={title ?? siteTitle} />
</slot>
<slot name="description">
  {
    siteDescription && (
      <meta name="description" content={siteDescription} />
    )
  }
  {
    siteDescription && (
      <meta property="twitter:description" content={siteDescription} />
    )
  }
  {
    siteDescription && (
      <meta property="og:description" content={siteDescription} />
    )
  }
</slot>

<meta
  name="theme-color"
  content="#e8e3d9"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#202725"
  media="(prefers-color-scheme: dark)"
/>
<meta name="theme-color" content="#e8e3d9" />
{/*Open Graph / Facebook*/}
<meta name="fediverse:creator" content="@justsml@mastodon.social" />
<meta name="bsky:creator" content="@justsml.bsky.social" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
{imgSrc && <meta property="og:image" content={new URL(imgSrc, Astro.url)} />}
{imageWidth && <meta property="og:image:width" content={`${imageWidth}`} />}
{imageHeight && <meta property="og:image:height" content={`${imageHeight}`} />}

{/*Twitter*/}
<meta property="twitter:site" content="@justsml" />
<meta name="twitter:creator" content="@justsml" />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
{
  imgSrc && (
    <meta property="twitter:image" content={new URL(imgSrc, Astro.url)} />
  )
}

<link rel="apple-touch-icon" sizes="72x72" href="/icons/apple-icon-72x72.png" />
<link
  rel="apple-touch-icon"
  sizes="120x120"
  href="/icons/apple-icon-120x120.png"
/>
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/icons/apple-icon-180x180.png"
/>

<link
  rel="icon"
  type="image/webp"
  sizes="48x48"
  href="/icons/icon-48x48.webp"
/>
<link
  rel="icon"
  type="image/webp"
  sizes="256x256"
  href="/icons/icon-256x256.webp"
/>
<link
  rel="icon"
  type="image/webp"
  sizes="512x512"
  href="/icons/icon-512x512.webp"
/>

