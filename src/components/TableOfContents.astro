---
import type { TocSection } from "../shared/articleHeadings";
import type { Locale } from "../shared/i18n";

interface Props {
  sections: TocSection[];
  locale: Locale;
  presentation: "mobile" | "desktop";
}

const { sections, locale, presentation } = Astro.props;
const labels: Record<Locale, { title: string; subsections: string }> = {
  en: { title: "On this page", subsections: "Subsections" },
  es: { title: "En esta página", subsections: "Subsecciones" },
  hi: { title: "इस पृष्ठ पर", subsections: "उपखंड" },
  ja: { title: "このページの内容", subsections: "小見出し" },
  ru: { title: "На этой странице", subsections: "Подразделы" },
  de: { title: "Auf dieser Seite", subsections: "Unterabschnitte" },
  fr: { title: "Sur cette page", subsections: "Sous-sections" },
  it: { title: "In questa pagina", subsections: "Sottosezioni" },
  ar: { title: "في هذه الصفحة", subsections: "الأقسام الفرعية" },
  he: { title: "בעמוד זה", subsections: "סעיפי משנה" },
  zh: { title: "本页内容", subsections: "子章节" },
};
const label = labels[locale];
---

<nav class:list={["article-toc", presentation]} aria-label={label.title} data-pagefind-ignore="all">
  <details open={presentation === "desktop"}>
    <summary class="toc-title">
      <span>{label.title}</span>
      <svg class="toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </summary>
    <ul class="toc-sections">
      {sections.map((section) => (
        <li>
          <a href={`#${section.slug}`}>{section.text}</a>
          {section.children.length > 0 && (
            <ul class="toc-subsections">
              {section.children.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </details>
</nav>

<style>
  .article-toc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--paper-muted);
    background: var(--paper-sheet);
    border: 1px solid var(--paper-line);
    border-block-start: 3px solid var(--paper-blue);
  }
  .article-toc.mobile {
    margin-block: 1rem 2rem;
    border-radius: 0;
    overflow: hidden;
  }
  .article-toc .toc-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--paper-ink);
    letter-spacing: 0.04em;
    list-style: none;
    cursor: pointer;
  }
  .toc-title::-webkit-details-marker { display: none; }
  .toc-chevron { flex: none; transition: transform 150ms ease; }
  details[open] > .toc-title .toc-chevron { transform: rotate(180deg); }
  .article-toc .toc-sections,
  .article-toc .toc-subsections {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .article-toc li { list-style: none; }
  .article-toc li::marker { content: ""; }
  .article-toc .toc-sections { counter-reset: toc-section; padding: 0 1.25rem 1rem; }
  .article-toc .toc-sections > li {
    counter-increment: toc-section;
    margin: 0;
    padding-block: 0.125rem;
  }
  .article-toc .toc-sections > li > a {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 0.5rem;
    font-weight: 500;
  }
  .toc-sections > li > a::before {
    content: counter(toc-section, decimal-leading-zero);
    color: var(--paper-blue);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }
  .article-toc a {
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
    border-radius: 0.25rem;
  }
  .article-toc a:hover { color: var(--paper-blue); }
  .article-toc a:focus-visible, .toc-title:focus-visible {
    outline: 2px solid var(--paper-blue);
    outline-offset: 3px;
  }
  .article-toc .toc-subsections {
    margin: 0 0 0.5rem 2rem;
    padding-inline-start: 0.875rem;
    border-inline-start: 1px solid var(--paper-line);
    font-size: 0.8125rem;
    color: var(--paper-muted);
  }
  .article-toc .toc-subsections > li { margin: 0; padding: 0; }
  .toc-subsections a { display: block; padding-block: 0.375rem; }
  .article-toc.desktop { padding: 1rem; }
  .article-toc.desktop .toc-title { padding: 0 0 1rem; cursor: default; }
  .article-toc.desktop .toc-chevron { display: none; }
  .article-toc.desktop .toc-sections { padding: 0; }
  @media (prefers-reduced-motion: reduce) { .toc-chevron { transition: none; } }
  @media (min-width: 1280px) { .article-toc.mobile { display: none; } }
</style>
